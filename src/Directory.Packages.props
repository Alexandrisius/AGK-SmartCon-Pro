<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit — работает на обоих TFM (netstandard2.0) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Common" Version="8.3.2" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.3.2" />

    <!-- DI — НЕ ОБНОВЛЯТЬ выше 8.x! Версии 9.0+ дропнули net48.
         При апгрейде убедиться что новая версия поддерживает net48 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />

    <!-- C# polyfill для net48 (атрибуты: record, init, required и т.д.) -->
    <PackageVersion Include="PolySharp" Version="1.15.0" />

    <!-- Тестирование -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- JSON — заморожен на 8.0.6 (используется в других модулях проекта через System.Text.Json).
         Обновление System.Text.Json до 9.x/10.x ломает net48 (CS1739 AppendFormatted —
         DefaultInterpolatedStringHandler changes). GLB writer теперь zero-dependency и не
         использует System.Text.Json. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />

    <!-- Frozen polyfill versions (ADR-042): HelixToolkit.Wpf.SharpDX 3.1.2 transitively
         pulls System.Memory 4.6.3 + System.Buffers 4.6.1 + System.Runtime.CompilerServices.Unsafe 6.1.2
         which break net48 (CS1739 AppendFormatted — DefaultInterpolatedStringHandler changes signature).
         These PackageVersion pins + CentralPackageTransitivePinningEnabled (see Directory.Build.props)
         force these packages back to legacy-compatible versions on both TFM. -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />

    <!-- HttpClient для net48 (встроен в .NET 8 BCL) -->
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />

    <!-- WPF Behaviors — MVVM event-to-command binding (net48 + net8.0) -->
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />

    <!-- Material Design Icons via MahApps.Metro.IconPacks (net48 + net8.0) -->
    <PackageVersion Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />

    <!-- SQLite — version frozen at 8.x (9.0+ may break net48). Compatible with net8.0-windows and net48 (.NET Standard 2.0).
         SQLitePCLRaw.* are pinned in Directory.Build.props via top-level PackageReference on SmartCon.App
         and SmartCon.FamilyManager — that is required to satisfy the NuGet "Direct dependency wins" rule
         and avoid NETSDK1152 ("multiple output files with the same relative path: e_sqlite3.dll")
         during `dotnet publish` for net48. Microsoft.Data.Sqlite 8.0.28 declares a hard transitive
         dependency on SQLitePCLRaw.bundle_e_sqlite3 2.1.6 in its NuGet metadata, and CPM alone does
         not override that nested dep. See dependabot bump c321226 for historical context. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />

    <!-- CodePages encoding provider для Windows-1251 и других ANSI кодировок (не встроены в .NET Core) -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.10" />

    <!-- Universal charset detector (Mozilla algorithm) для автоопределения кодировок Type Catalog -->
    <PackageVersion Include="UTF.Unknown" Version="2.6.0" />

    <!-- Пины для merged SmartCon.Dependencies (net48, ADR-051): версии = текущее resolved-состояние,
         чтобы merge не менял фактические версии. Microsoft.Bcl.AsyncInterfaces 10.0.1 уже
         развёртывается в проде (тянет CommunityToolkit.Mvvm 8.4.2) — см. Issue #134. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.1" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="8.0.0" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" />


    <!-- HelixToolkit.Wpf.SharpDX — DirectX 11 WPF 3D viewer (ADR-042). net48 + net8.0-windows7.0.
         HelixToolkit.Toolkit.Wpf.SharpDX транситивно тянет HelixToolkit.Maths, HelixToolkit.SharpDX,
         и SharpDX.Direct3D11/Direct3D9/Direct2D1/DXGI/D3DCompiler (все 4.2.0 — legacy но поддерживается
         HelixToolkit v3.x). CommunityToolkit.* уже присутствуют на более новой 8.4.2 — CPM резолвит вверх. -->
    <PackageVersion Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />

    <!-- HelixToolkit.SharpDX.Assimp — production GLB/glTF/OBJ/FBX importer (ADR-042).
         Используется для загрузки GLB-файлов в SceneNodeGroupModel3D прямо в HelixToolkit scene graph.
         SharpAssimp тянет нативный Assimp dll (win-x64 included in runtimes/), works on net48 + net8.0.
         Scoped to net8.0-windows only — на net48 3D preview недоступен (silent no-op). -->
    <PackageVersion Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />

    <!--
      ВНИМАНИЕ: RevitAPI NuGet НЕ указываем в PackageVersion!
      Версия RevitAPI динамическая — задаётся через wildcard $(RevitVersion).*
      прямо в PackageReference (VersionOverride) в Directory.Build.targets.

      CPM требует либо PackageVersion, либо VersionOverride для каждого
      PackageReference. RevitAPI использует VersionOverride с wildcard,
      поэтому PackageVersion не нужен.
    -->
  </ItemGroup>
</Project>