<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit — работает на обоих TFM (netstandard2.0) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- DI — НЕ ОБНОВЛЯТЬ выше 8.x! Версии 9.0+ дропнули net48.
         При апгрейде убедиться что новая версия поддерживает net48 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- C# polyfill для net48 (атрибуты: record, init, required и т.д.) -->
    <PackageVersion Include="PolySharp" Version="1.15.0" />

    <!-- Тестирование -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- JSON для net48 -->
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />

    <!-- HttpClient для net48 (встроен в .NET 8 BCL) -->
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />

    <!-- WPF Behaviors — MVVM event-to-command binding (net48 + net8.0) -->
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />

    <!-- SQLite — version frozen at 8.x (9.0+ may break net48). Compatible with net8.0-windows and net48 (.NET Standard 2.0).
         SQLitePCLRaw.* are pinned in Directory.Build.props via top-level PackageReference on SmartCon.App
         and SmartCon.FamilyManager — that is required to satisfy the NuGet "Direct dependency wins" rule
         and avoid NETSDK1152 ("multiple output files with the same relative path: e_sqlite3.dll")
         during `dotnet publish` for net48. Microsoft.Data.Sqlite 8.0.28 declares a hard transitive
         dependency on SQLitePCLRaw.bundle_e_sqlite3 2.1.6 in its NuGet metadata, and CPM alone does
         not override that nested dep. See dependabot bump c321226 for historical context. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.28" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />

    <!-- CodePages encoding provider для Windows-1251 и других ANSI кодировок (не встроены в .NET Core) -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="8.0.0" />

    <!-- Universal charset detector (Mozilla algorithm) для автоопределения кодировок Type Catalog -->
    <PackageVersion Include="UTF.Unknown" Version="2.6.0" />

    <!--
      ВНИМАНИЕ: RevitAPI NuGet НЕ указываем в PackageVersion!
      Версия RevitAPI динамическая — задаётся через wildcard $(RevitVersion).*
      прямо в PackageReference (VersionOverride) в Directory.Build.targets.

      CPM требует либо PackageVersion, либо VersionOverride для каждого
      PackageReference. RevitAPI использует VersionOverride с wildcard,
      поэтому PackageVersion не нужен.
    -->
  </ItemGroup>
</Project>