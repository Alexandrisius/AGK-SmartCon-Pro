<UserControl x:Class="SmartCon.Agent.Views.AgentPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
             xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
             xmlns:uiBehaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
             xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
             xmlns:vm="clr-namespace:SmartCon.Agent.ViewModels"
             xmlns:agentConverters="clr-namespace:SmartCon.Agent.Converters"
             xmlns:behaviors="clr-namespace:SmartCon.Agent.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SingletonResources/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InvertBoolConverter x:Key="InvertBool"/>
            <agentConverters:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlow"/>

            <Style x:Key="RoundIconButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundSecondaryIconButton" TargetType="Button"
                   BasedOn="{StaticResource RoundIconButton}">
                <Setter Property="Background" Value="{DynamicResource StatusBarSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="ImageThumbButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThumbCloseButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="White"
                                    CornerRadius="9"
                                    Width="18" Height="18"
                                    BorderBrush="#22000000"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BackdropButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="2,10,0,4"/>
            </Style>

            <Style x:Key="SettingsHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="2,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <DataTemplate DataType="{x:Type vm:AgentChatItemViewModel}">
                <Grid Margin="0,5">

                    <!-- Assistant message -->
                    <Grid x:Name="AssistantRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Top" Margin="0,16,8,0">
                            <iconPacks:PackIconMaterial Kind="Robot"
                                                        Width="15" Height="15"
                                                        Foreground="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="520">
                            <TextBlock Text="{Binding Header}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,0,0,3"/>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderAltBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3,12,12,12"
                                    Padding="11,8">
                                <StackPanel>
                                    <TextBlock x:Name="AssistantPlain"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               LineHeight="18"/>
                                    <FlowDocumentScrollViewer x:Name="AssistantMarkdown"
                                                              Document="{Binding MarkdownText, Converter={StaticResource MarkdownToFlow}}"
                                                              Visibility="Collapsed"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="0"
                                                              IsToolBarVisible="False"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              behaviors:MouseWheelRedirectBehavior.IsEnabled="True"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              FontFamily="Segoe UI"
                                                              FontSize="12"/>
                                    <TextBlock x:Name="AssistantStatus"
                                               Text="{Binding StatusText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Margin="0,4,0,0"/>
                                    <TextBlock x:Name="StreamingMark"
                                               Text="▍"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- User message -->
                    <Grid x:Name="UserRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="520">
                            <TextBlock Text="{Binding Header}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,2,3"/>
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="12,3,12,12"
                                    Padding="11,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               LineHeight="18"/>
                                    <ItemsControl ItemsSource="{Binding Attachments}"
                                                  Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ImageThumbButton}"
                                                        Command="{Binding DataContext.OpenImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:Loc Agent_Image_Open}">
                                                    <Border Margin="0,0,6,4"
                                                            CornerRadius="6"
                                                            Background="#22FFFFFF"
                                                            Padding="2">
                                                        <Image Source="{Binding Preview}"
                                                               MaxWidth="180"
                                                               MaxHeight="120"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource StatusBarSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderAltBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top" Margin="8,16,0,0">
                            <iconPacks:PackIconMaterial Kind="Account"
                                                        Width="15" Height="15"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Tool call: compact, aligned with the agent bubble, expandable -->
                    <Grid x:Name="ToolRow"
                          Visibility="Collapsed"
                          Margin="34,1,0,1"
                          HorizontalAlignment="Left"
                          MaxWidth="480">
                        <Border Background="{DynamicResource StatusBarSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderAltBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <iconPacks:PackIconMaterial x:Name="ToolIcon"
                                                                Kind="Wrench"
                                                                Width="11" Height="11"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Header}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Text}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0"/>
                                    <Button Grid.Column="3"
                                            Command="{Binding ToggleDetailsCommand}"
                                            Width="20" Height="20"
                                            Padding="0"
                                            Style="{DynamicResource FlatIconButton}"
                                            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                        <iconPacks:PackIconMaterial x:Name="ToolChevron"
                                                                    Kind="ChevronRight"
                                                                    Width="12" Height="12"
                                                                    Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>

                                <Border x:Name="ToolDetailsPanel"
                                        Visibility="Collapsed"
                                        Margin="0,6,0,0"
                                        Padding="6"
                                        CornerRadius="6"
                                        Background="#22000000"
                                        MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding Details}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Error / info message -->
                    <Grid x:Name="SystemRow" Visibility="Collapsed">
                        <Border x:Name="SystemBubble"
                                MaxWidth="520"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource StatusBarSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderAltBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <iconPacks:PackIconMaterial x:Name="SystemIcon"
                                                                Kind="Cog"
                                                                Width="11" Height="11"
                                                                Margin="0,0,5,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="SystemHeader"
                                               Text="{Binding Header}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="SystemText"
                                           Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="Collapsed"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding KindName}" Value="Assistant">
                        <Setter TargetName="AssistantRow" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindName}" Value="User">
                        <Setter TargetName="UserRow" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindName}" Value="Tool">
                        <Setter TargetName="ToolRow" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindName}" Value="Error">
                        <Setter TargetName="SystemRow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="SystemBubble" Property="BorderBrush"
                                Value="{DynamicResource DangerBrush}"/>
                        <Setter TargetName="SystemIcon" Property="Kind" Value="AlertOutline"/>
                        <Setter TargetName="SystemIcon" Property="Foreground"
                                Value="{DynamicResource DangerBrush}"/>
                        <Setter TargetName="SystemHeader" Property="Foreground"
                                Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindName}" Value="Info">
                        <Setter TargetName="SystemRow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="SystemBubble" Property="Background" Value="Transparent"/>
                        <Setter TargetName="SystemBubble" Property="BorderThickness" Value="0"/>
                        <Setter TargetName="SystemIcon" Property="Kind" Value="InformationOutline"/>
                        <Setter TargetName="SystemText" Property="FontStyle" Value="Italic"/>
                        <Setter TargetName="SystemText" Property="Foreground"
                                Value="{DynamicResource TextMutedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasHeader}" Value="False">
                        <Setter TargetName="SystemHeader" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                        <Setter TargetName="AssistantStatus" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                        <Setter TargetName="StreamingMark" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStreaming}" Value="False">
                        <Setter TargetName="AssistantPlain" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="AssistantMarkdown" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="ToolDetailsPanel" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ToolChevron" Property="Kind" Value="ChevronDown"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                        <Setter TargetName="ToolIcon" Property="Foreground"
                                Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6" behaviors:FileDropBehavior.Command="{Binding AddDroppedFilesCommand}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="30" Height="30" CornerRadius="9"
                    Background="{DynamicResource AccentBrush}"
                    Margin="0,0,8,0">
                <iconPacks:PackIconMaterial Kind="Robot"
                                            Width="17" Height="17"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Agent_Assistant}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding ProviderLabel}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{Binding NewSessionCommand}"
                    Width="28" Height="28"
                    Style="{DynamicResource FlatIconButton}"
                    ToolTip="{loc:Loc Agent_Session_New}">
                <iconPacks:PackIconMaterial Kind="Plus"
                                            Width="15" Height="15"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding OpenSettingsCommand}"
                    Width="28" Height="28"
                    Style="{DynamicResource FlatIconButton}"
                    ToolTip="{loc:Loc Agent_Settings_Tooltip}">
                <iconPacks:PackIconMaterial Kind="Cog"
                                            Width="15" Height="15"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
        </Grid>

        <!-- Sessions of the current document -->
        <ComboBox Grid.Row="1"
                  ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"
                  DisplayMemberPath="Title"
                  VerticalContentAlignment="Center"
                  Height="26"
                  Margin="0,0,0,4"
                  Style="{DynamicResource CompactComboBox}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                  ToolTip="{loc:Loc Agent_Session_Tooltip}"/>

        <!-- Approval mode + warning banners -->
        <StackPanel Grid.Row="2">
            <Border Margin="0,0,0,6"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsApprovalWarningVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="AlertOutline"
                                                Width="15" Height="15"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ApprovalWarningText}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Grid.Column="2"
                            Command="{Binding DisableApprovalBypassCommand}"
                            Content="{Binding ApprovalDisableText}"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource FlatIconButton}"/>
                </Grid>
            </Border>

            <!-- Warning banner -->
            <Border Margin="0,0,0,6"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="AlertOutline"
                                                Width="15" Height="15"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding BannerText}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Chat transcript -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="2,0"
                          behaviors:ChatAutoScrollBehavior.ItemsSource="{Binding Messages}">
                <ItemsControl ItemsSource="{Binding Messages}" Focusable="False"/>
            </ScrollViewer>

            <StackPanel Panel.ZIndex="500"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsChatEmpty, Converter={StaticResource BoolToVis}}">
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderAltBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="RobotOutline"
                                                Width="28" Height="28"
                                                Opacity="0.7"
                                                Foreground="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{loc:Loc Agent_Empty_Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="{loc:Loc Agent_Empty_Hint}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="280"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4"
              Margin="2,2,0,0"
              Visibility="{Binding IsTyping, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="26" Height="26" CornerRadius="13"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Top" Margin="0,2,8,0">
                <iconPacks:PackIconMaterial Kind="Robot"
                                            Width="15" Height="15"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    BorderThickness="1"
                    CornerRadius="3,12,12,12"
                    Padding="12,11">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="TypingDot1" Width="6" Height="6"
                             Fill="{DynamicResource TextMutedBrush}"
                             Margin="0,0,5,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="TypingDot1Transform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="TypingDot2" Width="6" Height="6"
                             Fill="{DynamicResource TextMutedBrush}"
                             Margin="0,0,5,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="TypingDot2Transform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="TypingDot3" Width="6" Height="6"
                             Fill="{DynamicResource TextMutedBrush}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="TypingDot3Transform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>
            </Border>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="TypingDot1"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="TypingDot1Transform"
                                             Storyboard.TargetProperty="Y"
                                             From="0" To="-3"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="TypingDot2"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="TypingDot2Transform"
                                             Storyboard.TargetProperty="Y"
                                             From="0" To="-3"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="TypingDot3"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.30"/>
                            <DoubleAnimation Storyboard.TargetName="TypingDot3Transform"
                                             Storyboard.TargetProperty="Y"
                                             From="0" To="-3"
                                             Duration="0:0:0.45"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.30"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <!-- Attachments -->
        <ItemsControl Grid.Row="5"
                      ItemsSource="{Binding Attachments}"
                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"
                      Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,6,4"
                            BorderBrush="{DynamicResource BorderAltBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource StatusBarSurfaceBrush}">
                        <Grid>
                            <Button Style="{StaticResource ImageThumbButton}"
                                    Command="{Binding DataContext.OpenImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{loc:Loc Agent_Image_Open}">
                                <Image Source="{Binding Preview}"
                                       Width="64"
                                       Height="44"
                                       Stretch="UniformToFill"/>
                            </Button>
                            <Button Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,2,2,0"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{loc:Loc Agent_Tooltip_RemoveAttachment}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ThumbCloseButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="8" Height="8" Stretch="Uniform">
                                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Composer -->
        <Border Grid.Row="6"
                Margin="0,8,0,0"
                Padding="9,7,7,7"
                CornerRadius="11"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderAltBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             MinHeight="36"
                             MaxHeight="120"
                             Padding="1,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             behaviors:ClipboardImagePasteBehavior.Command="{Binding PasteImageCommand}"
                             behaviors:EnterSendsBehavior.Command="{Binding SendCommand}"
                             uiBehaviors:TextBoxBehaviors.Placeholder="{Binding ElementName=InputPlaceholder}"
                             ToolTip="{loc:Loc Agent_Input_Tooltip}"/>
                    <TextBlock x:Name="InputPlaceholder"
                               Text="{loc:Loc Agent_Input_Placeholder}"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="1,1,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding AttachFilesCommand}"
                            Width="26" Height="26"
                            Style="{DynamicResource FlatIconButton}"
                            ToolTip="{loc:Loc Agent_Attach}">
                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                            <Path Data="M16.5,6V17.5C16.5,19.71 14.71,21.5 12.5,21.5C10.29,21.5 8.5,19.71 8.5,17.5V5C8.5,3.62 9.62,2.5 11,2.5C12.38,2.5 13.5,3.62 13.5,5V15.5C13.5,16.05 13.05,16.5 12.5,16.5C11.95,16.5 11.5,16.05 11.5,15.5V6H10V15.5C10,16.88 11.12,18 12.5,18C13.88,18 15,16.88 15,15.5V5C15,2.79 13.21,1 11,1C8.79,1 7,2.79 7,5V17.5C7,20.54 9.46,23 12.5,23C15.54,23 18,20.54 18,17.5V6H16.5Z"
                                  Fill="{DynamicResource TextMutedBrush}"/>
                        </Viewbox>
                    </Button>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ApprovalModes}"
                              SelectedItem="{Binding SelectedApprovalMode}"
                              DisplayMemberPath="Label"
                              Width="132"
                              Height="26"
                              Margin="4,0,4,0"
                              VerticalContentAlignment="Center"
                              Style="{DynamicResource CompactComboBox}"
                              ToolTip="{Binding ApprovalModeTooltip}"/>

                    <TextBlock Grid.Column="2"
                               Text="{loc:Loc Agent_Input_Hint}"
                               FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="3"
                            Command="{Binding StopCommand}"
                            Width="30" Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource RoundSecondaryIconButton}"
                            ToolTip="{loc:Loc Agent_Stop}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <iconPacks:PackIconMaterial Kind="Stop"
                                                    Width="14" Height="14"
                                                    Foreground="{DynamicResource DangerBrush}"/>
                    </Button>

                    <Button Grid.Column="4"
                            Command="{Binding SendCommand}"
                            Width="30" Height="30"
                            Style="{StaticResource RoundIconButton}"
                            ToolTip="{loc:Loc Agent_Send}">
                        <iconPacks:PackIconMaterial Kind="Send"
                                                    Width="15" Height="15"
                                                    Foreground="White"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Status -->
        <Grid Grid.Row="7" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1"
                       Text="{Binding TokenSummary}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- Write confirmation overlay -->
        <Grid Grid.RowSpan="8"
              Panel.ZIndex="1100"
              Background="#99000000"
              Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="360"
                    MaxHeight="560"
                    Padding="16"
                    CornerRadius="12"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <iconPacks:PackIconMaterial Kind="AlertOutline"
                                                    Width="16" Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc Agent_Confirm_Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ConfirmationOperation}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ConfirmationAffected}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc Agent_Confirm_Reversible}"
                                   FontSize="9"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ConfirmationRisks}"
                                   FontSize="10"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasConfirmationRisks, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ConfirmationDigest, StringFormat=digest: {0}}"
                                   FontSize="9"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Margin="0,8,0,0"
                            Padding="8"
                            CornerRadius="8"
                            Background="{DynamicResource StatusBarSurfaceBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="220">
                            <TextBox Text="{Binding ConfirmationDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="10"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Content="{loc:Loc Agent_Confirm_Cancel}"
                                Command="{Binding RejectConfirmationCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                Height="28"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Content="{loc:Loc Agent_Confirm_Apply}"
                                Command="{Binding ApproveConfirmationCommand}"
                                Style="{DynamicResource PrimaryButton}"
                                Height="28"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings overlay -->
        <Grid Grid.RowSpan="8"
              Panel.ZIndex="1000"
              Background="#99000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="320"
                    MaxHeight="560"
                    Padding="16"
                    CornerRadius="12"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <iconPacks:PackIconMaterial Kind="Cog"
                                                        Width="16" Height="16"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Agent_Settings_Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Agent_Settings_Provider}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding ProviderOptions}"
                                  SelectedItem="{Binding SettingsProvider}"
                                  Height="28"
                                  Style="{DynamicResource CompactComboBox}"/>

                        <TextBlock Text="{loc:Loc Agent_Settings_Model}" Style="{StaticResource SettingsLabel}"/>
                        <TextBox Text="{Binding SettingsModel, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Style="{DynamicResource CompactTextBox}"/>

                        <TextBlock Text="{loc:Loc Agent_Settings_ApiKey}" Style="{StaticResource SettingsLabel}"/>
                        <TextBox Text="{Binding SettingsApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Style="{DynamicResource CompactTextBox}"/>
                        <TextBlock Text="{loc:Loc Agent_Settings_ApiKeyHint}" Style="{StaticResource SettingsHint}"/>

                        <TextBlock Text="{loc:Loc Agent_Settings_DecisionModel}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding DecisionModelOptions}"
                                  SelectedItem="{Binding SelectedDecisionModel}"
                                  DisplayMemberPath="Label"
                                  Height="28"
                                  Style="{DynamicResource CompactComboBox}"/>
                        <TextBlock Text="{loc:Loc Agent_Settings_DecisionHint}" Style="{StaticResource SettingsHint}"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Content="{loc:Loc Agent_Settings_Cancel}"
                                    Command="{Binding CloseSettingsCommand}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Height="28"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="2"
                                    Content="{loc:Loc Agent_Settings_Save}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{DynamicResource PrimaryButton}"
                                    Height="28"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Full-size image preview -->
        <Grid Grid.RowSpan="8"
              Panel.ZIndex="1200"
              Background="#CC000000"
              Visibility="{Binding IsImagePreviewOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding CloseImagePreviewCommand}"
                    Style="{StaticResource BackdropButton}"/>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="18"
                    Padding="6"
                    CornerRadius="10"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    BorderThickness="1">
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       MaxWidth="1400"
                       MaxHeight="900"/>
            </Border>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Width="30" Height="30"
                    Style="{DynamicResource FlatIconButton}"
                    Command="{Binding CloseImagePreviewCommand}"
                    ToolTip="{loc:Loc Agent_Image_Close}">
                <iconPacks:PackIconMaterial Kind="Close"
                                            Width="14" Height="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>