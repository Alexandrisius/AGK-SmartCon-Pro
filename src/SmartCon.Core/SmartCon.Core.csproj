<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartCon.Core</RootNamespace>
    <AssemblyName>SmartCon.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartCon.Tests" />
    <InternalsVisibleTo Include="SmartCon.Revit" />
  </ItemGroup>

  <!-- RevitAPI: compile-time only (I-09: carrier types — ElementId, XYZ).
       ExcludeAssets=runtime: DLL не копируется в output, загружается из Revit. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- SmartCon.Dependencies (обе TFM, ADR-051): STJ на net48; M.E.DI.Abstractions
       и M.D.Sqlite — merged-типы на обеих TFM (#177). -->
  <ItemGroup>
    <ProjectReference Include="..\SmartCon.Dependencies\SmartCon.Dependencies.csproj" />
  </ItemGroup>

  <!-- System.Memory (net48): раньше приезжал транзитивно через M.D.Sqlite → SQLitePCLRaw.core;
       после merge M.D.Sqlite (#177) нужен явно — STJ API (ReadOnlySpan/ReadOnlyMemory). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

</Project>
