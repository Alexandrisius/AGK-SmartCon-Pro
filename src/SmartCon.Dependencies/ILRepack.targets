<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Explicit ILRepack merge for SmartCon.Dependencies (Issue #134, ADR-051).
    Merge rule: пакет сшивается, только если ни один ПОДПИСАННЫЙ сторонний компонент
    не ссылается на него по strong name (иначе 0x80131044/0x80131040 у потребителя).
    Loose-файлы транзитивов (Common/Diagnostics/Memory/Buffers/...) НЕ сшиваются —
    они поставляются как подписанные оригиналы (см. SmartCon.App.csproj net48 block).
    Keep in sync with:
      src/SmartCon.App/Resources/merged-dependencies.txt
      src/Directory.Build.targets (ExcludeAssets block)
  -->
  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <InputAssemblies Include="$(OutputPath)SmartCon.Dependencies.dll" />
      <InputAssemblies Include="$(OutputPath)CommunityToolkit.Mvvm.dll" />
      <InputAssemblies Include="$(OutputPath)Microsoft.Extensions.DependencyInjection.dll" />
      <InputAssemblies Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" />
      <InputAssemblies Include="$(OutputPath)System.Text.Json.dll" />
      <InputAssemblies Include="$(OutputPath)System.Text.Encodings.Web.dll" />
      <InputAssemblies Include="$(OutputPath)UtfUnknown.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
      <InputAssemblies Include="$(OutputPath)SmartCon.Dependencies.dll" />
      <InputAssemblies Include="$(OutputPath)Nice3point.Revit.Toolkit.dll" />
    </ItemGroup>

    <ILRepack
        Parallel="true"
        DebugInfo="true"
        Internalize="false"
        InputAssemblies="@(InputAssemblies)"
        TargetKind="Dll"
        LibraryPath="$(OutputPath)"
        KeyFile="$(MSBuildThisFileDirectory)SmartCon.snk"
        OutputFile="$(OutputPath)SmartCon.Dependencies.dll" />

    <ItemGroup>
      <MergedInputs Include="@(InputAssemblies)" Exclude="$(OutputPath)SmartCon.Dependencies.dll" />
    </ItemGroup>
    <Delete Files="@(MergedInputs)" />
  </Target>

</Project>
