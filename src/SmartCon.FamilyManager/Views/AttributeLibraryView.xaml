<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.AttributeLibraryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        Title="{loc:Loc FM_AL_Title}"
        Width="700" Height="480" MinWidth="550" MinHeight="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ui:SingletonResources>
            <Style x:Key="CenterCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SingleClickEditCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactDataGridCell}">
                <Setter Property="behaviors:DataGridBehaviors.SingleClickEdit" Value="True"/>
            </Style>
        </ui:SingletonResources>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="AttributesGrid" Grid.Row="0"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Style="{DynamicResource CompactDataGrid}"
                  RowStyle="{DynamicResource CompactDataGridRow}"
                  CellStyle="{DynamicResource CompactDataGridCell}"
                  >
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName"
                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTemplateColumn x:Name="ColGroup" Width="140"
                                        CellStyle="{StaticResource SingleClickEditCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Group}" Style="{StaticResource CenterCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableGroups, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Text="{Binding Group, UpdateSourceTrigger=LostFocus}"
                                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                      behaviors:ComboBoxFilterBehavior.IsEnabled="True"
                                      behaviors:ComboBoxFilterBehavior.FocusOnLoaded="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColActive" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      behaviors:CheckBoxToggleBehavior.ToggleCommand="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      behaviors:CheckBoxToggleBehavior.ToggleCommandParameter="{Binding}"
                                      IsThreeState="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{loc:Loc FM_AL_Add}" Command="{Binding AddAttributeCommand}"
                    Style="{DynamicResource SecondaryButton}" MinWidth="90" Margin="0,0,4,0"/>
            <Button Content="{loc:Loc FM_AL_Delete}" Command="{Binding DeleteCommand}"
                    Style="{DynamicResource SecondaryButton}" MinWidth="90"/>
            <Button Content="{loc:Loc FM_AL_FromSharedParams}" Command="{Binding ImportFromSharedParametersCommand}"
                    Style="{DynamicResource SecondaryButton}" MinWidth="90" Margin="4,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc Btn_OK}" Command="{Binding OkCommand}"
                    Style="{DynamicResource PrimaryButton}" Width="80" Height="28" IsDefault="True"/>
            <Button Content="{loc:Loc Btn_Cancel}" Command="{Binding CancelAsyncCommand}"
                    Style="{DynamicResource SecondaryButton}" Width="80" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:DialogWindowBase>
