<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.InputDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ui:SingletonResources/>
    </Window.Resources>

    <Grid Margin="16" MinWidth="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Style="{DynamicResource CompactTextBox}"
                     Background="Transparent"
                     behaviors:FocusBehavior.FocusOnLoad="True"
                     behaviors:TextBoxBehaviors.Placeholder="{Binding ElementName=InputPlaceholder}"
                     x:Name="InputTextBox"/>
            <TextBlock x:Name="InputPlaceholder"
                       Text="{Binding PlaceholderText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="8,0,6,0"
                       IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{loc:Loc Btn_OK}"
                    Command="{Binding OkCommand}"
                    Width="80" Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="{loc:Loc Btn_Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="80" Height="28"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</controls:DialogWindowBase>
