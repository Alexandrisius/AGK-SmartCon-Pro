<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.CategoryTreeEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="{loc:Loc FM_CTE_CategoriesAndAttrs}"
        Width="850" Height="580" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ui:SingletonResources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,7,16,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="1">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PressedSurfaceBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,7,16,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="1">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFEECEE"/>
                                    <Setter Property="Foreground" Value="#FFE53935"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFDDDDD"/>
                                    <Setter Property="Foreground" Value="#FFC62828"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:SingletonResources>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderAltBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="12">
                    <TextBlock DockPanel.Dock="Top" 
                               Text="{loc:Loc FM_CTE_CategoryTree}"
                               FontWeight="SemiBold" 
                               FontSize="12"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TreeView x:Name="CategoryTree"
                              ItemsSource="{Binding RootNodes}"
                              behaviors:TreeViewBehaviors.RightClickSelect="True"
                              behaviors:TreeViewBehaviors.DeselectOnEmptyClick="True"
                              Background="Transparent"
                              BorderThickness="0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedItemChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=CategoryTree}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <TreeView.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Header="{loc:Loc FM_CTE_NewCategory}" Command="{Binding AddRootCommand}" Style="{StaticResource ModernMenuItem}"></MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FolderIconGeometry}"
                                           Fill="{DynamicResource TextMutedBrush}"
                                           Width="13" Height="13"
                                           Margin="0,0,6,0"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" 
                                               VerticalAlignment="Center"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding FamilyCount, StringFormat='({0})'}"
                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"></Setter>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"></Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Style="{StaticResource ModernContextMenu}"
                                                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{loc:Loc FM_CTE_ContextMenu_Rename}" Command="{Binding ContextMenuRenameCommand}" Style="{StaticResource ModernMenuItem}"></MenuItem>
                                            <MenuItem Header="{loc:Loc FM_CTE_ContextMenu_AddChild}" Command="{Binding ContextMenuAddChildCommand}" Style="{StaticResource ModernMenuItem}"></MenuItem>
                                            <MenuItem Header="{loc:Loc FM_CTE_ContextMenu_Delete}" Command="{Binding ContextMenuDeleteCommand}" Style="{StaticResource DangerMenuItem}"></MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>

                <GridSplitter Grid.Column="1" 
                              Width="2" 
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" 
                              Background="{DynamicResource BorderAltBrush}"
                              Margin="0,8"/>

                <Grid Grid.Column="2" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding HasSelectedCategory, Converter={StaticResource BoolToVis}}">
                        <Run Text="{loc:Loc FM_CTE_AttributesFor}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelectedCategoryPath, Mode=OneWay}"/>
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,0,0,8"
                          Visibility="{Binding HasSelectedCategory, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" MinWidth="140" Margin="0,0,8,0">
                            <ComboBox ItemsSource="{Binding AvailableGroups}"
                                      SelectedItem="{Binding SelectedGroupFilter}"
                                      Style="{DynamicResource CompactComboBox}"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding AttributeFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.Placeholder="{Binding ElementName=SearchPlaceholder}"
                                     Style="{DynamicResource CompactTextBox}"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="{loc:Loc FM_CTE_SearchAttrs}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="8,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <ScrollViewer Grid.Row="2" 
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedCategory, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding AttributeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6"
                                            Background="Transparent"
                                            CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverAltSurfaceBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Margin="0,0,8,0">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBox}">
                                                        <Setter Property="IsChecked" Value="{Binding IsBound, Mode=OneWay}"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="Command" Value="{Binding ToggleBindingCommand}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsInherited}" Value="True"/>
                                                                    <Condition Binding="{Binding IsBound}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <TextBlock Grid.Column="2" Text="{Binding Group}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" 
                               Text="{loc:Loc FM_CTE_SelectCategoryHint}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                   Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Loc FM_CTE_Import}"
                    Command="{Binding ImportFromJsonCommand}"
                    MinWidth="80"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="12,4" Margin="0,0,4,0"/>

            <Grid Grid.Column="1" Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{loc:Loc FM_CTE_Export}"
                        Command="{Binding ExportFullCommand}"
                        MinWidth="60"
                        Style="{DynamicResource SecondaryButton}"
                        Padding="12,4"/>

                <ToggleButton Grid.Column="1"
                              x:Name="ExportSplitToggle"
                              IsChecked="{Binding IsOpen, ElementName=ExportSplitPopup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="18"
                              Margin="1,0,0,0"
                              Style="{DynamicResource ModernSplitToggle}">
                    <Path Data="M 0,0 L 4,4 L 8,0"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.2"
                          Margin="2,3,2,1"
                          Stretch="Uniform"/>
                </ToggleButton>

                <Popup x:Name="ExportSplitPopup"
                       StaysOpen="False"
                       PlacementTarget="{Binding ElementName=ExportSplitToggle}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderAltBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4">
                        <StackPanel>
                            <Button Content="{loc:Loc FM_CTE_ExportTree}"
                                    Command="{Binding ExportCategoriesCommand}"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,6"
                                    MinWidth="180"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="{loc:Loc FM_CTE_ExportAttrs}"
                                    Command="{Binding ExportAttributesCommand}"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="{loc:Loc FM_CTE_ExportFull}"
                                    Command="{Binding ExportFullCommand}"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Button Grid.Column="2"
                    Content="{loc:Loc FM_CTE_Attributes}"
                    Command="{Binding OpenAttributeLibraryCommand}"
                    MinWidth="90"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="12,4" Margin="4,0,0,0"/>

            <Button Grid.Column="4"
                    Content="{loc:Loc Btn_OK}"
                    Command="{Binding OkCommand}"
                    Width="80" Height="28"
                    Padding="12,4" Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButton}"/>

            <Button Grid.Column="5" Content="{loc:Loc Btn_Cancel}"
                    Command="{Binding CancelAsyncCommand}"
                    Width="80" Height="28"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="12,4"/>
        </Grid>
    </Grid>
</controls:DialogWindowBase>
