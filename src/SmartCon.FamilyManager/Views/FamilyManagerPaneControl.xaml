<UserControl x:Class="SmartCon.FamilyManager.Views.FamilyManagerPaneControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:vm="clr-namespace:SmartCon.FamilyManager.ViewModels"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:fmbehaviors="clr-namespace:SmartCon.FamilyManager.Behaviors"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        xmlns:selectors="clr-namespace:SmartCon.FamilyManager.Selectors"
        xmlns:views="clr-namespace:SmartCon.FamilyManager.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SingletonResources/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:StaleCountToTooltipConverter x:Key="StaleCountToTooltipConverter"/>
            <converters:StaleReasonToTooltipConverter x:Key="StaleReasonToTooltipConverter"/>
            <converters:TotalItemCountToTooltipConverter x:Key="TotalItemCountToTooltipConverter"/>
            <converters:SearchHighlightConverter x:Key="SearchHighlight"/>

            <Style x:Key="DangerIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderAltBrush}"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFEECEE"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE53935"/>
                                    <Setter Property="Foreground" Value="#FFE53935"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFDDDDD"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,7,16,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"
                                                          Grid.Column="0"/>
                                        <Path x:Name="Arrow"
                                              Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                              Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="SubMenuPopup"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Right"
                                       HorizontalOffset="-4"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border x:Name="SubMenuBorder"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PressedSurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,7,16,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="1">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFEECEE"/>
                                    <Setter Property="Foreground" Value="#FFE53935"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFDDDDD"/>
                                    <Setter Property="Foreground" Value="#FFC62828"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryToggleButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderAltBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedSurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedSurfaceBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DisabledBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DbGeneralTemplate" DataType="{x:Type selectors:DatabaseListItem}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0">
                        <iconPacks:PackIconMaterial Kind="Database"
                                                       Width="24" Height="24"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="DbProjectMatchTemplate" DataType="{x:Type selectors:DatabaseListItem}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0">
                        <Path Data="{StaticResource FolderIconGeometry}"
                              Fill="{DynamicResource TextMutedBrush}"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="DbProjectMismatchTemplate" DataType="{x:Type selectors:DatabaseListItem}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding MismatchReason}">
                    <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0">
                        <iconPacks:PackIconMaterial Kind="Lock"
                                                       Width="24" Height="24"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </DataTemplate>

            <selectors:DatabaseListItemIconSelector x:Key="DbItemTemplateSelector"
                GeneralTemplate="{StaticResource DbGeneralTemplate}"
                ProjectMatchTemplate="{StaticResource DbProjectMatchTemplate}"
                ProjectMismatchTemplate="{StaticResource DbProjectMismatchTemplate}"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar (FindInCatalog | Import | Profile | Settings) -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Find in Catalog -->
            <Button Grid.Column="0"
                    Command="{Binding FindInCatalogCommand}"
                    Margin="0,0,2,0"
                    Width="28"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="0"
                    ToolTip="{loc:Loc FM_Tip_FindInCatalog}"
                    Visibility="{Binding HasActiveDatabase, Converter={StaticResource BoolToVis}}">
                <Viewbox Width="12" Height="12" Stretch="Uniform">
                    <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5C12.7,16.5 11.2,17 9.5,17C5.4,17 2,13.6 2,9.5C2,5.4 5.4,2 9.5,2C13.6,2 17,5.4 17,9.5C17,11.2 16.5,12.7 15.5,14ZM9.5,14C11.9,14 14,11.9 14,9.5C14,7.1 11.9,5 9.5,5C7.1,5 5,7.1 5,9.5C5,11.9 7.1,14 9.5,14Z"
                          Fill="{DynamicResource TextPrimaryBrush}"/>
                </Viewbox>
            </Button>

            <!-- Left: Import -->
            <Grid Grid.Column="1" Visibility="{Binding CanImport, Converter={StaticResource BoolToVis}}"
                  Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{loc:Loc FM_Import}"
                        Command="{Binding ImportFilesCommand}"
                        MinWidth="52"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,0"
                        Padding="8,4"/>

                <ToggleButton Grid.Column="1"
                              x:Name="ImportSplitToggle"
                              IsChecked="{Binding IsOpen, ElementName=ImportSplitPopup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="18"
                              Margin="1,0,0,0"
                              Style="{DynamicResource ModernSplitToggle}">
                    <Path Data="M 0,0 L 4,4 L 8,0"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.2"
                          Margin="2,3,2,1"
                          Stretch="Uniform"/>
                </ToggleButton>

                <Popup x:Name="ImportSplitPopup"
                       StaysOpen="False"
                       PlacementTarget="{Binding ElementName=ImportSplitToggle}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="{DynamicResource BorderAltBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4">
                        <StackPanel>
                            <Button Content="{loc:Loc FM_ImportActiveFile}"
                                    Command="{Binding ImportActiveFileCommand}"
                                    MinWidth="160"
                                    HorizontalContentAlignment="Left"
                                    Padding="10,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ImportSplitPopup}" PropertyName="IsOpen" Value="False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <Button Content="{loc:Loc FM_ImportSelectedElements}"
                                    Command="{Binding ImportSelectedElementsCommand}"
                                    MinWidth="160"
                                    HorizontalContentAlignment="Left"
                                    Padding="10,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ImportSplitPopup}" PropertyName="IsOpen" Value="False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Center: Profile -->
            <Button Grid.Column="2"
                    Command="{Binding OpenProfileCommand}"
                    Width="28"
                    HorizontalAlignment="Center"
                    Padding="0"
                    ToolTipService.ShowOnDisabled="True">
                <Button.Style>
                    <Style BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
                        <Setter Property="ToolTip" Value="{loc:Loc FM_Profile}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveDatabase}" Value="False">
                                <Setter Property="ToolTip" Value="{loc:Loc FM_ProfileDisabledTooltip}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Viewbox Width="12" Height="12" Stretch="Uniform">
                    <Path Data="M 6,0 C 7.66,0 9,1.34 9,3 C 9,4.66 7.66,6 6,6 C 4.34,6 3,4.66 3,3 C 3,1.34 4.34,0 6,0 Z M 6,7.5 C 9.31,7.5 12,8.84 12,10.5 L 12,12 L 0,12 L 0,10.5 C 0,8.84 2.69,7.5 6,7.5 Z"
                          Fill="{DynamicResource TextPrimaryBrush}"/>
                </Viewbox>
            </Button>

            <!-- Right: Settings -->
            <Button Grid.Column="3"
                    Command="{Binding OpenCategoryEditorCommand}"
                    Width="28"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="0"
                    ToolTip="{loc:Loc FM_Tip_EditCategories}">
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="{DynamicResource TextMutedBrush}"/>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Row 1: Database controls (Create split | ComboBox | Tools) -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Create database popup -->
            <ToggleButton Grid.Column="0"
                          x:Name="CreateDbToggle"
                          IsChecked="{Binding IsOpen, ElementName=CreateDbPopup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="28"
                          Margin="0,0,2,0"
                          Style="{DynamicResource SecondaryToggleButton}"
                          ToolTip="{loc:Loc FM_PBase_CreateDatabase}">
                <Viewbox Width="8" Height="8" Stretch="Uniform">
                    <Path Data="M 0,4 L 8,4 M 4,0 L 4,8"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.5"/>
                </Viewbox>
            </ToggleButton>

            <Popup x:Name="CreateDbPopup"
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=CreateDbToggle}"
                   Placement="Bottom"
                   AllowsTransparency="True">
                <Border Background="White"
                        BorderBrush="{DynamicResource BorderAltBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                    <StackPanel>
                        <Button Content="{loc:Loc FM_PBase_CreateGeneralDatabase}"
                                Command="{Binding CreateGeneralDatabaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=CreateDbPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Content="{loc:Loc FM_PBase_CreateProjectDatabase}"
                                Command="{Binding CreateProjectDatabaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=CreateDbPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Active database -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Connections}"
                      SelectedItem="{Binding SelectedConnection}"
                      ItemTemplateSelector="{StaticResource DbItemTemplateSelector}"
                      VerticalContentAlignment="Center"
                      Margin="0,0,2,0"
                      MinWidth="80"
                      Height="28"
                      Style="{DynamicResource CompactComboBox}"/>

            <!-- Database tools popup -->
            <ToggleButton Grid.Column="2"
                          x:Name="DbToolsToggle"
                          IsChecked="{Binding IsOpen, ElementName=DbToolsPopup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="28"
                          Margin="0,0,0,0"
                          Style="{DynamicResource SecondaryToggleButton}"
                          ToolTip="{loc:Loc FM_PBase_DatabaseTools}">
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Grid Width="24" Height="24">
                        <iconPacks:PackIconMaterial Kind="Database"
                                                       Width="22" Height="22"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="16" Height="16"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-1,-1"
                                 Background="{DynamicResource SurfaceBrush}"
                                 CornerRadius="8">
                            <iconPacks:PackIconMaterial Kind="Cog"
                                                           Width="14" Height="14"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Viewbox>
            </ToggleButton>

            <Popup x:Name="DbToolsPopup"
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=DbToolsToggle}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   AllowsTransparency="True">
                <Border Background="White"
                        BorderBrush="{DynamicResource BorderAltBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                    <StackPanel>
                        <Button Content="{loc:Loc FM_PBase_ConnectDatabase}"
                                Command="{Binding ConnectDatabaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=DbToolsPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Content="{loc:Loc FM_PBase_DisconnectDatabase}"
                                Command="{Binding DisconnectDatabaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=DbToolsPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Content="{loc:Loc FM_PBase_ConfigureProjectBase}"
                                Command="{Binding ConfigureProjectBaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=DbToolsPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Content="{loc:Loc FM_PBase_DeleteDatabase}"
                                Command="{Binding DeleteDatabaseCommand}"
                                MinWidth="180"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=DbToolsPopup}" PropertyName="IsOpen" Value="False"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Row 2: Refresh + Search -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding RefreshTreeCommand}"
                    Margin="0,0,2,0"
                    Width="28"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="0"
                    ToolTip="{loc:Loc FM_RefreshTooltip}">
                <TextBlock Text="&#x21BB;"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-1,0,0"/>
            </Button>

            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="6,4,24,4"
                         Height="28"
                         Style="{DynamicResource CompactTextBox}"
                         behaviors:TextBoxBehaviors.Placeholder="{Binding ElementName=SearchPlaceholder}"
                         Background="Transparent"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="{loc:Loc FM_SearchPlaceholder}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="8,0,24,0"
                           IsHitTestVisible="False"/>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        Width="20" Height="20"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4"
                        Visibility="{Binding IsSearchNotEmpty, Converter={StaticResource BoolToVis}}">
                    <Viewbox Width="10" Height="10" Stretch="Uniform">
                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>

        <!-- TreeView wrapped in Grid so that the overlay panel can sit on top
             of it with Panel.ZIndex=1000. Panel.ZIndex is the ONLY reliable
             way to ensure the sticky overlay is drawn above all TreeViewItems
             (TranslateTransform on TreeViewItem headers does not promote
             Z-order relative to sibling TreeViewItems). -->
        <Grid Grid.Row="3">
            <TreeView x:Name="CategoryTree"
                      ItemsSource="{Binding TreeNodes}"
                      behaviors:TreeViewBehaviors.RightClickSelect="True"
                      behaviors:TreeViewBehaviors.DeselectOnEmptyClick="True"
                       behaviors:TreeViewDragDropBehavior.StartDragCommand="{Binding StartDragCommand}"
                       behaviors:TreeViewDragDropBehavior.DropCommand="{Binding DropFamilyCommand}"
                       behaviors:TreeViewDragDropBehavior.PlacementDragCommand="{Binding StartPlacementDragCommand}"
                       behaviors:TreeViewDragDropBehavior.AutoExpandDelayMilliseconds="500"
                       behaviors:TreeViewDragDropBehavior.AutoScrollTopInset="{Binding ElementName=StickyOverlay, Path=ActualHeight}"
                       behaviors:TreeViewBehaviors.AutoScrollToSelectedItem="True"
                       behaviors:TreeViewDragDropBehavior.ResolveParentDropTarget="True"
                      fmbehaviors:StickyCategoryHeaderBehavior.Enabled="True"
                      fmbehaviors:StickyCategoryHeaderBehavior.Overlay="{Binding ElementName=StickyStack}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderAltBrush}"
                      BorderThickness="1"
                      Padding="2"
                      AllowDrop="True">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedItemChanged">
                    <i:InvokeCommandAction Command="{Binding TreeViewSelectedItemChangedCommand}"
                                           CommandParameter="{Binding SelectedItem, ElementName=CategoryTree}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <TreeView.Resources>
                <ContextMenu x:Key="CategoryNodeContextMenu" Style="{StaticResource ModernContextMenu}"
                             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{loc:Loc FM_ImportToCategory}"
                              Command="{Binding ImportFileToCategoryCommand}"
                              Style="{StaticResource ModernMenuItem}" />

                    <MenuItem Header="{loc:Loc FM_Update}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.HasStale, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                        <MenuItem Header="{loc:Loc FM_UpdateKeepParams}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding UpdateCategoryKeepParamsCommand}"
                                  behaviors:MenuItemCommandParameterRequery.RequeryOnChange="True"
                                  Style="{StaticResource ModernMenuItem}" />
                        <MenuItem Header="{loc:Loc FM_UpdateOverwriteParams}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding UpdateCategoryOverwriteParamsCommand}"
                                  behaviors:MenuItemCommandParameterRequery.RequeryOnChange="True"
                                  Style="{StaticResource ModernMenuItem}" />
                    </MenuItem>

                    <MenuItem Header="{loc:Loc FM_Check}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding CheckCategoryCommand}"
                              behaviors:MenuItemCommandParameterRequery.RequeryOnChange="True"
                              Style="{StaticResource ModernMenuItem}" />
                </ContextMenu>

                <ContextMenu x:Key="FamilyLeafNodeContextMenu" Style="{StaticResource ModernContextMenu}"
                             Focusable="False"
                             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{loc:Loc FM_LoadToProject}"
                              Command="{Binding LoadToProjectCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsStale, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc FM_Update}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsStale, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                        <MenuItem Header="{loc:Loc FM_UpdateKeepParams}"
                                  Command="{Binding UpdateStaleKeepParamsCommand}"
                                  Style="{StaticResource ModernMenuItem}" />
                        <MenuItem Header="{loc:Loc FM_UpdateOverwriteParams}"
                                  Command="{Binding UpdateStaleCommand}"
                                  Style="{StaticResource ModernMenuItem}" />
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
                                <Setter Property="Header" Value="{loc:Loc FM_Edit}"/>
                                <Setter Property="Command" Value="{Binding EditFamilyCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FamilySource}" Value="system">
                                        <Setter Property="Header" Value="{loc:Loc FM_EditSystemFamily}"/>
                                        <Setter Property="Command" Value="{Binding EditSystemFamilyCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc FM_Check}"
                              Command="{Binding CheckFamilyCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              behaviors:MenuItemCommandParameterRequery.RequeryOnChange="True"
                              Style="{StaticResource ModernMenuItem}" />
                    <MenuItem Header="{loc:Loc FM_Properties}"
                              Command="{Binding OpenPropertiesCommand}"
                              Style="{StaticResource ModernMenuItem}" />
                    <MenuItem Header="{loc:Loc FM_DeleteFromCatalog}"
                              Command="{Binding DeleteFamilyCommand}"
                              Style="{StaticResource DangerMenuItem}" />
                </ContextMenu>

                <ContextMenu x:Key="FamilyTypeNodeContextMenu" Style="{StaticResource ModernContextMenu}"
                             Focusable="False"
                             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{loc:Loc FM_PlaceType}"
                              Command="{Binding PlaceTypeCommand}"
                              Style="{StaticResource ModernMenuItem}" />
                </ContextMenu>

                <Style x:Key="FamilyTreeItemBaseStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="behaviors:TreeViewBehaviors.SuppressHorizontalScrollOnBringIntoView" Value="True"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                <Condition Binding="{Binding IsType}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="CategoryNodeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource FamilyTreeItemBaseStyle}">
                    <Setter Property="ContextMenu" Value="{StaticResource CategoryNodeContextMenu}"/>
                </Style>

                <Style x:Key="FamilyLeafNodeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource FamilyTreeItemBaseStyle}">
                    <Setter Property="ContextMenu" Value="{StaticResource FamilyLeafNodeContextMenu}"/>
                </Style>

                <Style x:Key="FamilyTypeNodeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource FamilyTreeItemBaseStyle}">
                    <Setter Property="ContextMenu" Value="{StaticResource FamilyTypeNodeContextMenu}"/>
                </Style>

                <selectors:FamilyTreeItemStyleSelector x:Key="FamilyTreeItemStyleSelector"
                    CategoryStyle="{StaticResource CategoryNodeItemStyle}"
                    FamilyStyle="{StaticResource FamilyLeafNodeItemStyle}"
                    TypeStyle="{StaticResource FamilyTypeNodeItemStyle}"/>

                <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNodeViewModel}"
                                           ItemsSource="{Binding Children}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Path Data="{StaticResource FolderIconGeometry}"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" ⚠"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding HasStale, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding StaleCount, Converter={StaticResource StaleCountToTooltipConverter}}"/>
                            <TextBlock Text="{Binding FamilyCount, StringFormat=' ({0})'}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding DataContext.ToggleSubtreeCommand,
                                                  RelativeSource={RelativeSource AncestorType=TreeView}}"
                                CommandParameter="{Binding}"
                                Width="20" Height="20"
                                Margin="6,0,4,0"
                                Cursor="Hand"
                                Focusable="False"
                                ToolTip="{loc:Loc FM_ToggleSubtreeTooltip}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatIconButton}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                                       RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource UnfoldMoreGeometry}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnyDescendantCollapsed}" Value="False">
                                                <Setter Property="Data" Value="{StaticResource UnfoldLessGeometry}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </Grid>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type vm:FamilyLeafNodeViewModel}"
                                             ItemsSource="{Binding Children}">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ToolTip>
                                <ToolTip Content="{Binding TooltipViewModel}">
                                    <ToolTip.ContentTemplate>
                                        <DataTemplate>
                                            <views:FamilyTooltipView />
                                        </DataTemplate>
                                    </ToolTip.ContentTemplate>
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <ContentControl VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextPrimaryBrush}">
                                <ContentControl.Content>
                                    <MultiBinding Converter="{StaticResource SearchHighlight}">
                                        <Binding Path="DisplayName"/>
                                        <Binding Path="DataContext.SearchText" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                    </MultiBinding>
                                </ContentControl.Content>
                            </ContentControl>

                            <TextBlock Text="{Binding VersionLabel, StringFormat='{}({0})'}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>

                            <TextBlock Text="{loc:Loc FM_Stale}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding StaleReason, Converter={StaticResource StaleReasonToTooltipConverter}}"/>
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:FamilyTypeNodeViewModel}">
                    <Grid HorizontalAlignment="Stretch">
                        <ContentControl VerticalAlignment="Center">
                            <ContentControl.Content>
                                <MultiBinding Converter="{StaticResource SearchHighlight}">
                                    <Binding Path="DisplayName"/>
                                    <Binding Path="DataContext.SearchText" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                </MultiBinding>
                            </ContentControl.Content>
                        </ContentControl>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>

            <TreeView.ItemContainerStyleSelector>
                <StaticResourceExtension ResourceKey="FamilyTreeItemStyleSelector"/>
            </TreeView.ItemContainerStyleSelector>
            </TreeView>

            <!-- Sticky overlay: Panel.ZIndex="1000" гарантирует что стек прилипших
                 Category-заголовков рисуется ПОВЕРХ всех TreeViewItem.
                 StickyOverlay Border IsHitTestVisible=True + Background=Transparent —
                 вся область sticky перехватывает клики, не пропуская их к TreeViewItem под ней.
                 PreviewMouseWheel обрабатывается в Behavior и перенаправляется в ScrollViewer,
                 чтобы скролл не ломался при наведении на sticky-область. -->
            <Border x:Name="StickyOverlay"
                    Panel.ZIndex="1000"
                    IsHitTestVisible="True"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="Transparent">
                <StackPanel x:Name="StickyStack" Background="Transparent"/>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center">
                <Button Command="{Binding CollapseAllTreeCommand}"
                        Width="28" Height="28"
                        Cursor="Hand"
                        Focusable="False"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="{loc:Loc FM_CollapseAllTooltip}"
                        Style="{StaticResource FlatIconButton}">
                    <Path Data="{StaticResource UnfoldLessGeometry}"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding ExpandAllTreeCommand}"
                        Width="28" Height="28"
                        Cursor="Hand"
                        Focusable="False"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="{loc:Loc FM_ExpandAllTooltip}"
                        Style="{StaticResource FlatIconButton}">
                    <Path Data="{StaticResource UnfoldMoreGeometry}"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}"
                       MaxHeight="36"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding TotalItemCount}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="8,0,4,0"
                       MinWidth="40"
                       TextAlignment="Right"
                       ToolTip="{Binding TotalItemCount, Converter={StaticResource TotalItemCountToTooltipConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
