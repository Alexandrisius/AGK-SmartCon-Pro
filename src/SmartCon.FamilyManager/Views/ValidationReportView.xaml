<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.ValidationReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        Title="{loc:Loc FM_ValidationReport_Title}"
        Width="920" Height="480" MinWidth="700" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">

    <controls:DialogWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SingletonResources/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </controls:DialogWindowBase.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1AF44336"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8"
                Visibility="{Binding HasBlockedBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BlockedBannerText}"
                       Foreground="#F44336"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <iconPacks:PackIconMaterial Kind="{Binding HeaderIconKind}"
                                        Foreground="{Binding HeaderIconBrush}"
                                        Width="20" Height="20"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
            <TextBlock Text="{Binding FamilyName}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding CategoryPath, StringFormat=' — {0}'}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding Summary}"
                   Margin="28,0,0,8"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"/>

        <!-- Content: system issues as wrapped selectable cards on top,
             rule violations as a table below. The cards row sizes to its
             content (capped + scrollable when numerous) so a single card
             never leaves a dead gap before the table; the table takes
             all remaining height. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding HealthSectionTitle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"
                       Visibility="{Binding HasHealthCards, Converter={StaticResource BoolToVis}}"/>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="240"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasHealthCards, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding HealthCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderAltBrush}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                                Width="15" Height="15"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                <Setter Property="Foreground" Value="#FB8C00"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Kind" Value="CloseCircleOutline"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>

                                    <StackPanel Grid.Column="1">
                                        <!-- Family-level issues (document warnings) carry no
                                             type: the empty line is collapsed, otherwise it
                                             leaves a ghost 16px gap and the centered icon
                                             floats above the text's visual center. -->
                                        <TextBlock Text="{Binding TypeName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasTypeName, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Read-only borderless TextBox (not TextBlock): the user can
                                             select and copy any fragment of Revit's error text. -->
                                        <TextBox Text="{Binding Description}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 Margin="0,2,0,0"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 TextWrapping="Wrap"
                                                 Cursor="IBeam"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="{Binding ViolationsSectionTitle}"
                       FontWeight="SemiBold"
                       Margin="0,4,0,4"
                       Visibility="{Binding HasViolations, Converter={StaticResource BoolToVis}}"/>

            <DataGrid x:Name="IssuesGrid"
                      Grid.Row="3"
                      ItemsSource="{Binding Issues}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{DynamicResource CompactDataGrid}"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Visibility="{Binding HasViolations, Converter={StaticResource BoolToVis}}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource CompactDataGridCell}">
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColType" Binding="{Binding TypeName}" Width="*" MinWidth="80">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColAttribute" Binding="{Binding AttributeName}" Width="*" MinWidth="100">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColCheck" Binding="{Binding CheckDescription}" Width="175" CanUserResize="False">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColExpected" Binding="{Binding ExpectedValue}" Width="*" MinWidth="100">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColActual" Binding="{Binding ActualValue}" Width="*" MinWidth="100">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc FM_HealthReport_Copy}"
                    Command="{Binding CopyCommand}"
                    ToolTip="{loc:Loc FM_HealthReport_CopyTooltip}"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButton}"/>
            <Button Content="{loc:Loc FM_ValidationReport_Close}"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="90"
                    Style="{DynamicResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</controls:DialogWindowBase>
