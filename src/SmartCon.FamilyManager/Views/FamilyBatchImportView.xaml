<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.FamilyBatchImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartCon.FamilyManager.ViewModels"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:fmModels="clr-namespace:SmartCon.Core.Models.FamilyManager;assembly=SmartCon.Core"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Loc FM_BatchImport_Title}"
        Width="1080" Height="520"
        MinWidth="880" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource FontFamily}">

    <controls:DialogWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SingletonResources/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:FamilyBatchImportActionConverter x:Key="ActionConverter"/>
            <converters:FamilyBatchImportStatusConverter x:Key="StatusConverter"/>
            <converters:TypeCountToDisplayConverter x:Key="TypeCountConverter"/>
            <Style x:Key="CenterCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LeftCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
            <!--
                Enterprise multi-select pattern (Microsoft / Syncfusion
                best practice): bind DataGridRow.IsSelected TwoWay to the
                row VM's IsSelected property. The DataGrid uses its native
                SelectionMode="Extended" for Ctrl/Shift/Click selection,
                and the RestoreMultiSelectOnCellClick behavior below
                preserves multi-select when the user clicks an inline
                editor (ComboBox / Button) inside an already-selected cell.

                Defined at the window level (not DataGrid.Resources) so
                that SingletonResources — which expose CompactDataGridRow
                and CompactDataGridColumnHeader — are already in scope
                when this style is resolved.
            -->
            <Style x:Key="BatchImportRowStyle"
                   TargetType="DataGridRow"
                   BasedOn="{StaticResource CompactDataGridRow}">
                <Setter Property="IsSelected"
                        Value="{Binding IsSelected, Mode=TwoWay}"/>
            </Style>
            <!--
                Issue #135 (P1/P4): category column cell. The tooltip
                explains WHERE the category came from (provenance), and
                the cell flashes (whole-cell, light blue, hold+fade) when
                the rename handler changes the category automatically.
                BasedOn the shared compact cell so padding/selection
                behaviour stays identical to the other columns.
            -->
            <Style x:Key="CategoryCellStyle"
                   TargetType="DataGridCell"
                   BasedOn="{StaticResource CompactDataGridCell}">
                <Setter Property="ToolTip"
                        Value="{Binding CategoryProvenanceDescription}"/>
                <Setter Property="behaviors:CellFlashBehavior.FlashToken"
                        Value="{Binding CategoryFlashToken}"/>
            </Style>
        </ResourceDictionary>
    </controls:DialogWindowBase.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                  Text="{loc:Loc FM_BatchImport_Title}"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Margin="0,0,0,8"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  VerticalAlignment="Center"/>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderAltBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource SurfaceBrush}">
            <DataGrid ItemsSource="{Binding Items}"
                     AutoGenerateColumns="False"
                     Style="{DynamicResource CompactDataGrid}"
                     RowStyle="{StaticResource BatchImportRowStyle}"
                     CellStyle="{DynamicResource CompactDataGridCell}"
                     IsEnabled="{Binding IsGridEnabled}"
                     SelectionMode="Extended"
                     SelectionUnit="FullRow"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="False"
                     EnableRowVirtualization="False"
                     behaviors:DataGridBehaviors.DeselectOnEmptyClick="True"
                     behaviors:DataGridBehaviors.RestoreMultiSelectOnCellClick="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" MinWidth="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ImportErrorMessage}">
                                    <iconPacks:PackIconMaterial Kind="Check"
                                                                Foreground="#4CAF50"
                                                                Width="16" Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportRowState}"
                                                                 Value="{x:Static fmModels:FamilyBatchImportRowState.Success}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>
                                    <iconPacks:PackIconMaterial Kind="Close"
                                                                Foreground="#F44336"
                                                                Width="16" Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportRowState}"
                                                                 Value="{x:Static fmModels:FamilyBatchImportRowState.Error}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>
                                    <iconPacks:PackIconMaterial Kind="TimerSand"
                                                                Foreground="#2196F3"
                                                                Width="16" Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportRowState}"
                                                                 Value="{x:Static fmModels:FamilyBatchImportRowState.Running}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColFileName"
                                        Binding="{Binding FileName}"
                                        Width="*"
                                        MinWidth="350"
                                        ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn x:Name="ColRevitVersion"
                                        Binding="{Binding RevitMajorVersion}"
                                        Width="Auto"
                                        MinWidth="80"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTextColumn x:Name="ColTypeCount"
                                        Binding="{Binding TypeCount, Converter={StaticResource TypeCountConverter}}"
                                        Width="Auto"
                                        MinWidth="50"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTemplateColumn x:Name="ColStatus"
                                            Width="Auto"
                                            MinWidth="110"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StatusConverter}">
                                                <Binding Path="Status"/>
                                                <Binding Path="MatchedVersionLabel"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <!-- Issue #126: warning icon for cross-name duplicates.
                                         Shown only when the content hash matched an item under
                                         a DIFFERENT name (the file was renamed). The tooltip
                                         explains what MakeActive / IncrementVersion will do. -->
                                    <TextBlock Text="⚠"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource WarningBrush}"
                                               ToolTip="{Binding CrossNameDuplicateTooltip}"
                                               Visibility="{Binding IsCrossNameDuplicate, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColCategory"
                                            Width="*"
                                            MinWidth="120"
                                            CellStyle="{StaticResource CategoryCellStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        Issue #135 (P3): italic+gray ghost for the
                                        «Без категории» placeholder so it never reads
                                        as a real category. No bold for locked
                                        categories — provenance lives in the cell
                                        tooltip (P1).
                                    -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TargetCategoryPath}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TargetCategoryId}" Value="{x:Null}">
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Issue #135 (P2): warn that the locked category
                                         will MOVE the existing family on import. Same
                                         visual pattern as the cross-name duplicate ⚠. -->
                                    <TextBlock Grid.Column="1"
                                               Text="⚠"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource WarningBrush}"
                                               ToolTip="{Binding CategoryMoveWarningTooltip}"
                                               Visibility="{Binding ShowCategoryMoveWarning, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Column="2"
                                            Content="..."
                                            Command="{Binding PickCategoryCommand}"
                                            Padding="6,0"
                                            Margin="2,0,4,0"
                                            Width="28" Height="20"
                                            Style="{DynamicResource SecondaryButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColAction"
                                            Width="Auto"
                                            MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableActions}"
                                          SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Height="24"
                                          BorderThickness="0"
                                          Padding="2,0"
                                          Style="{DynamicResource CompactComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ActionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom: progress / summary + buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                <ProgressBar Value="{Binding ProgressValue}"
                             Maximum="{Binding ProgressMaximum}"
                             Minimum="0"
                             Height="6"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="0"
                       Text="{Binding SummaryMessage}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Visibility="{Binding IsSummary, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="{Binding PrimaryButtonText}"
                        Command="{Binding ImportCommand}"
                        IsDefault="True"
                        Style="{DynamicResource PrimaryButton}"
                        MinWidth="100" Height="28"
                        Padding="10,0"/>
                <Button Content="{Binding SecondaryButtonText}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Visibility="{Binding IsSecondaryVisible, Converter={StaticResource BoolToVis}}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="100" Height="28"
                        Padding="10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</controls:DialogWindowBase>
