<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.FamilyPropertiesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="hx"
        Title="{loc:Loc FM_Props_Title}"
        Width="950" Height="900" MinWidth="800" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ui:SingletonResources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:PathToBitmapImageConverter x:Key="PathToBitmapImageConverter"/>
            <converters:TypeCountToDisplayConverter x:Key="TypeCountConverter"/>
            <!-- ADR-041 rev #5: ElementStyle for short columns (Revit version,
                 Types count, Status badge). Per MS Learn / SO best practice:
                 apply TextAlignment=Center + VerticalAlignment=Center via
                 ElementStyle (TargetType=TextBlock), not CellStyle — the
                 latter only centres the cell container, not the text itself. -->
            <Style x:Key="CenteredTextCell" TargetType="TextBlock"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LeftTextCell" TargetType="TextBlock"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextAlignment" Value="Left"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
            </Style>
            <!-- Versions tab "Family name" column: long file names are
                 ellipsed; the full name stays available in the tooltip. -->
            <Style x:Key="VersionFileNameCell" TargetType="TextBlock"
                   BasedOn="{StaticResource LeftTextCell}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding FileName, TargetNullValue='—'}"/>
            </Style>
        </ui:SingletonResources>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="280" Height="210"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <TextBlock Text="{loc:Loc FM_Props_NoAvatar}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Visibility>
                            <Binding Path="HasAvatar" Converter="{StaticResource BoolToVisibility}" ConverterParameter="Invert"/>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <Image Source="{Binding AvatarImage}"
                           Stretch="UniformToFill" StretchDirection="Both"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding CanWriteProperty, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="{loc:Loc FM_Props_ChangeImage}"
                                Command="{Binding ChangeAvatarCommand}"
                                Style="{DynamicResource GhostButton}"
                                FontSize="11" Padding="8,2"/>
                        <Button Content="{loc:Loc FM_Props_RemoveImage}"
                                Command="{Binding RemoveAvatarCommand}"
                                Style="{DynamicResource GhostButton}"
                                FontSize="11" Padding="8,2" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Loc FM_Name}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" FontWeight="SemiBold" Padding="4,2" Margin="0,0,0,12"
                         Height="Auto" MaxHeight="52" TextWrapping="Wrap" AcceptsReturn="False"
                         IsReadOnly="{Binding IsReadOnly}"
                         Style="{DynamicResource CompactTextBox}"/>

                <TextBlock Text="{loc:Loc FM_Category}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CategoryPath, Mode=OneWay}" IsReadOnly="True"
                             Padding="4,2" Style="{DynamicResource CompactTextBox}"
                             Background="{DynamicResource HoverAltSurfaceBrush}"/>
                    <Button Grid.Column="1" Content="..." Command="{Binding PickCategoryCommand}"
                            Width="28" Height="24" Margin="4,0,0,0"
                            Style="{DynamicResource SecondaryButton}" Padding="0"/>
                </Grid>

                <TextBlock Text="{loc:Loc FM_Status}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedStatus}"
                          IsEnabled="{Binding CanWriteProperty}"
                          Style="{DynamicResource CompactComboBox}" Margin="0,0,0,8"/>

                <TextBlock Text="{loc:Loc FM_Tags}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <Border BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="4,3"
                        Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="11"
                                                Background="{DynamicResource HoverAltSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderAltBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,4,0" Padding="8,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                                <Button Content="&#xD7;"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="2,0" Margin="6,0,0,0" FontSize="13"
                                                        Height="16" Width="16"
                                                        Style="{DynamicResource GhostButton}"
                                                        Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBox x:Name="TagInputBox"
                                     Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="2,2" MinWidth="100"
                                     VerticalAlignment="Center"
                                     PreviewKeyDown="TagInputBox_PreviewKeyDown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding AddTagCommand}"
                                                CommandParameter="{Binding Text, ElementName=TagInputBox}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Popup IsOpen="{Binding HasTagSuggestions, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=TagInputBox}"
                                   StaysOpen="False" MaxHeight="200" AllowsTransparency="True">
                                <Border BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}" MinWidth="200">
                                    <ListBox ItemsSource="{Binding FilteredTagSuggestions}"
                                             SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                             Padding="0" BorderThickness="0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11">
                    <Run Text="{loc:Loc FM_Props_Version}"/>: <Run Text="{Binding VersionLabel, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1" Margin="0,0,0,8" Background="{DynamicResource BorderAltBrush}"/>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{DynamicResource FlatTabControl}">

            <TabItem Style="{DynamicResource FlatTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{loc:Loc FM_Tab_General}"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc FM_Description}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="100" Padding="6,4"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{DynamicResource CompactTextBox}" Margin="0,0,0,16"/>

                        <TextBlock Text="{loc:Loc FM_Props_FileInfo}" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc FM_Props_Created}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAtText, Mode=OneWay}" Margin="8,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc FM_Props_Updated}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAtText, Mode=OneWay}" Margin="8,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{DynamicResource FlatTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{loc:Loc FM_Tab_Content}"/>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: unified add button -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="{loc:Loc FM_Props_AddFileUnified}"
                                Command="{Binding AddFileUnifiedCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                FontSize="12" Padding="12,4"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Dual-pane: sidebar + content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar: category list -->
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderAltBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="4">
                            <ListBox ItemsSource="{Binding CategoryItems}"
                                     SelectedValue="{Binding SelectedContentCategory, Mode=TwoWay}"
                                     SelectedValuePath="Category"
                                     ItemContainerStyle="{DynamicResource CompactListBoxItem}"
                                     Style="{DynamicResource NoFocusListBox}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Count}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Content: asset list with scroll -->
                        <Border Grid.Column="1" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource BorderAltBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="4">
                            <Grid>
                                <!-- Asset list -->
                                <ListBox ItemsSource="{Binding FilteredAssets}"
                                         ItemContainerStyle="{DynamicResource CompactListBoxItem}"
                                         Style="{DynamicResource NoFocusListBox}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Thumbnail for images -->
                                            <Image Grid.Column="0" Width="32" Height="32"
                                                   Source="{Binding ResolvedPath, Converter={StaticResource PathToBitmapImageConverter}, ConverterParameter=64}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <!-- File name + size -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <!-- Star: primary indicator + set-as-primary action -->
                                            <Button Grid.Column="2"
                                                    Content="★"
                                                    FontSize="16"
                                                    Command="{Binding DataContext.SetAsPrimaryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc FM_Props_SetPrimary}"
                                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Cursor="Hand" Padding="2" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Per-file version binding toggle + label -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding CanToggleVersionBinding, Converter={StaticResource BoolToVisibility}}"
                                                        Margin="4,0">
                                                <ToggleButton IsChecked="{Binding IsVersionBound, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleAssetVersionBindingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}"
                                                              Style="{DynamicResource CompactToggleSwitch}"
                                                              ToolTip="{loc:Loc FM_Props_AttachToVersionHint}"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc FM_Props_AttachToVersion}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="4"
                                                    Content="{loc:Loc FM_Props_Open}"
                                                    Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource GhostButton}" FontSize="10" Padding="4,1" Margin="4,0"/>
                                            <Button Grid.Column="5"
                                                    Content="{loc:Loc FM_Props_Delete}"
                                                    Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource GhostButton}" FontSize="10" Padding="4,1" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty state overlay -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasFilteredAssets, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="{loc:Loc FM_Props_EmptyStateTitle}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FM_Props_EmptyStateHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

            <TabItem Style="{DynamicResource FlatTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{loc:Loc FM_Tab_Attributes}"/>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: type selector (hidden for a single '<default>'
                         or virtual type — nothing meaningful to choose). -->
                    <Grid Visibility="{Binding ShowTypeSelector, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc FM_Props_TypeSize}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTypes}"
                                  SelectedItem="{Binding SelectedType}"
                                  DisplayMemberPath="TypeName"
                                  Style="{DynamicResource CompactComboBox}"/>
                    </Grid>

                    <!-- Empty states: no category / no bindings / not imported. -->
                    <TextBlock Grid.Row="1" Text="{loc:Loc FM_Props_NoCategoryAttr}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,24"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding HasNoCategory, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc FM_Props_NoBindingsAttr}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,24"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding HasNoBindings, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel Grid.Row="1" Visibility="{Binding HasNotImported, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center" Margin="0,24">
                        <TextBlock Text="{loc:Loc FM_Props_NotImported}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc FM_Props_NotImportedDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,4,0,0" MaxWidth="400"/>
                    </StackPanel>

                    <!-- Dual-pane: groups sidebar + attribute list. -->
                    <Grid Grid.Row="1" Visibility="{Binding HasAttributeData, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar: groups. -->
                        <Border BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1"
                                CornerRadius="4" Background="{DynamicResource SurfaceBrush}">
                            <ListBox ItemsSource="{Binding AttributeGroups}"
                                     SelectedValue="{Binding SelectedAttributeGroup, Mode=TwoWay}"
                                     SelectedValuePath="GroupName"
                                     Style="{DynamicResource NoFocusListBox}"
                                     ItemContainerStyle="{DynamicResource CompactListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Content: filtered attributes. -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1"
                                    CornerRadius="4" Background="{DynamicResource SurfaceBrush}">
                                <ListBox ItemsSource="{Binding FilteredAttributes}"
                                         Style="{DynamicResource NoFocusListBox}"
                                         ItemContainerStyle="{DynamicResource CompactListBoxItem}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Grid.IsSharedSizeScope="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AttrName"
                                                                  MinWidth="40" MaxWidth="280"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding AttributeName}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontWeight="Medium" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding AttributeName}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <TextBox Grid.Column="1"
                                                      Text="{Binding Value, TargetNullValue='—'}"
                                                      IsReadOnly="True"
                                                      TextWrapping="Wrap"
                                                      MaxHeight="52"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Padding="4,2"
                                                      Background="{DynamicResource HoverAltSurfaceBrush}"
                                                      Style="{DynamicResource CompactTextBox}"
                                                      ToolTip="{Binding Value}"
                                                      VerticalAlignment="Center"/>

                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                                  ToolTipService.InitialShowDelay="200">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding StatusDetail}" MaxWidth="320"
                                                                       TextWrapping="Wrap" FontSize="11"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <iconPacks:PackIconMaterial Kind="Check"
                                                                            Foreground="{DynamicResource SuccessBrush}"
                                                                            Width="14" Height="14"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFound}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                                <iconPacks:PackIconMaterial Kind="Close"
                                                                            Foreground="{DynamicResource DangerBrush}"
                                                                            Width="14" Height="14"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Grid.Row="0" Text="{loc:Loc FM_Props_NoAttributes}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,24"
                                       Visibility="{Binding HasFilteredAttributes, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Style="{DynamicResource FlatTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{loc:Loc FM_Tab_3DView}"/>
                </TabItem.Header>
                <Grid>
                    <mc:AlternateContent>
                        <mc:Choice Requires="hx">
                            <!-- ADR-042: HelixToolkit.Wpf.SharpDX DirectX 11 viewer.
                                 Only compiled into net8.0-windows (Revit 2025+) BAML.
                                 On net48 the mc:Fallback below is used instead. -->

                            <!-- Toolbar: Reset / Zoom Extents / Wireframe -->
                            <Border VerticalAlignment="Top" Height="32"
                                    Panel.ZIndex="10"
                                    Background="{DynamicResource BackgroundAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc FM_3D_ResetView}"
                                            Command="{Binding ResetCamera3DCommand}"
                                            Style="{DynamicResource GhostButton}"
                                            Padding="8,2" />
                                    <ToggleButton Content="{loc:Loc FM_3D_Wireframe}"
                                                  IsChecked="{Binding IsWireframeVisible, Mode=OneWay}"
                                                  Command="{Binding ToggleWireframe3DCommand}"
                                                  Padding="8,2" Margin="4,0,0,0" />
                                    <ComboBox ItemsSource="{Binding Available3DTypeNames}"
                                              SelectedItem="{Binding Selected3DTypeName, Mode=OneWay}"
                                              MinWidth="200"
                                              Margin="8,0,0,0"
                                              VerticalContentAlignment="Center"
                                              Visibility="{Binding HasMultiple3DTypes, Converter={StaticResource BoolToVisibility}}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding ChangeSelected3DTypeCommand}"
                                                                       CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- ADR-042: HelixToolkit Viewport3DX — DirectX 11 render surface.
                                  Lights + Scene3DRoot are bound via Items3D (ObservableElement3DCollection)
                                  containing lights + Scene3DRoot group. 
                                  InputBindings: RMB rotate, MMB zoom, LMB pan. -->
                            <hx:Viewport3DX x:Name="Properties3DViewport"
                                            Camera="{Binding Camera3D}"
                                            EffectsManager="{Binding EffectsManager3D}"
                                            Background="#FF1E1E2E"
                                            BackgroundColor="#FF1E1E2E"
                                            ShowViewCube="True"
                                            ShowCoordinateSystem="True"
                                            IsPanEnabled="True"
                                            IsRotationEnabled="True"
                                            IsZoomEnabled="True"
                                            UseDefaultGestures="True"
                                            ZoomExtentsWhenLoaded="False"
                                            FrameRate="60"
                                            ModelUpDirection="0,1,0"
                                            TextBrush="White"
                                            Loaded="OnViewport3DXLoaded">
                                <hx:Viewport3DX.InputBindings>
                                    <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="RightClick"/>
                                    <MouseBinding Command="hx:ViewportCommands.Zoom" Gesture="MiddleClick"/>
                                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="LeftClick"/>
                                </hx:Viewport3DX.InputBindings>
                                <hx:AmbientLight3D Color="#FF808080" />
                                <hx:DirectionalLight3D Direction="-1,-1,-1" Color="White" />
                                <hx:DirectionalLight3D Direction="1,-1,1" Color="#FF808080" />
                                <!-- Scene3DRoot added from code-behind via Viewport3DX.Items.Add -->
                            </hx:Viewport3DX>

                            <!-- Loading overlay: shown while GLB is being parsed by Assimp.
                                 BackgroundColor semi-transparent dark to indicate modal state. -->
                            <Border Background="#80000000"
                                    Panel.ZIndex="20"
                                    Visibility="{Binding IsLoading3D, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc FM_3D_Loading}"
                                               Foreground="White" FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- No-preview / error overlay: shown when HasNo3DPreview is true.
                                 Covers cases: no auto-extracted GLB asset, GLB missing on disk,
                                 Assimp parse failure, or net48 unsupported (impossible here since
                                 this whole content is net8-only — placeholder is below in Fallback). -->
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    Panel.ZIndex="15"
                                    Visibility="{Binding HasNo3DPreview, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                                    <TextBlock Text="{loc:Loc FM_Props_3DComingSoon}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Preview3DStatusMessage}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,0,0,16"/>
                                    <TextBlock Text="{loc:Loc FM_Props_3DDesc}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </mc:Choice>
                        <mc:Fallback>
                            <!-- Net48 stub (Revit 2019-2024): HelixToolkit.Wpf.SharpDX + Assimp not
                                 available (multi-version CPM scoping). Shows a "supported on Revit
                                 2025+" message and the list of user-uploaded Model3D assets (which
                                 are still accessible via Open button). -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                                <TextBlock Text="{loc:Loc FM_Props_3DComingSoon}"
                                           FontWeight="SemiBold" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{loc:Loc FM_3D_UnsupportedNet48}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <TextBlock Text="{loc:Loc FM_Props_3DDesc}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                                <ItemsControl ItemsSource="{Binding Model3DAssets}" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                <Button Content="{loc:Loc FM_Props_Open}"
                                                        Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource GhostButton}" FontSize="10" Padding="4,1"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </mc:Fallback>
                    </mc:AlternateContent>
                </Grid>
            </TabItem>

            <TabItem Style="{DynamicResource FlatTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{loc:Loc FM_Tab_Versions}"/>
                </TabItem.Header>
                <Grid Margin="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="VersionsGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersionRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{DynamicResource CompactDataGrid}"
                              RowStyle="{DynamicResource CompactDataGridRow}"
                              CellStyle="{DynamicResource CompactDataGridCell}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              EnableRowVirtualization="False"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{DynamicResource BorderAltBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColVersionLabel"
                                                Binding="{Binding VersionLabel}"
                                                ElementStyle="{StaticResource CenteredTextCell}"
                                                Width="70" MinWidth="60"/>
                            <!-- Issue #126: per-version family file name — the
                                 item name follows the ACTIVE version's file
                                 name, so archived versions may differ. Text
                                 column: left-aligned + ellipsis (MS DataGrid
                                 guidance), full name in tooltip. -->
                            <DataGridTextColumn x:Name="ColVersionFileName"
                                                Binding="{Binding FileName, TargetNullValue='—'}"
                                                ElementStyle="{StaticResource VersionFileNameCell}"
                                                Width="*" MinWidth="140"/>
                            <DataGridTextColumn x:Name="ColVersionRevit"
                                                Binding="{Binding RevitMajorVersion}"
                                                ElementStyle="{StaticResource CenteredTextCell}"
                                                Width="60" MinWidth="50"/>
                            <!-- ADR-041 rev #5: Types column shows TypesCountDisplay
                                 (real count from TypeNames). Custom tooltip with
                                 vertical bulleted list + scroll for 40-50 types.
                                 DataGridTemplateColumn is used (not DataGridTextColumn)
                                 because the tooltip needs structured content
                                 (ItemsControl in ScrollViewer), not a plain string.
                                 ToolTip has no fixed Width — expands to fit the
                                 longest type name (TextWrapping=NoWrap); MaxHeight
                                 + ScrollViewer prevent vertical overflow. -->
                            <DataGridTemplateColumn x:Name="ColVersionTypes"
                                                    Width="60" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypesCountDisplay}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxHeight="340" Padding="6,4"
                                                         Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource BorderAltBrush}"
                                                         BorderThickness="1">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Hidden">
                                                        <ItemsControl ItemsSource="{Binding TypeNames}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                        <TextBlock Text="•"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   FontSize="13"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Top"/>
                                                                        <TextBlock Text="{Binding}"
                                                                                   TextWrapping="NoWrap"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColVersionDate"
                                                Binding="{Binding PublishedAtText}"
                                                ElementStyle="{StaticResource CenteredTextCell}"
                                                Width="130" MinWidth="120"/>
                            <DataGridTextColumn x:Name="ColVersionAuthor"
                                                Binding="{Binding PublishedBy, TargetNullValue='—'}"
                                                ElementStyle="{StaticResource CenteredTextCell}"
                                                Width="100" MinWidth="80"/>
                            <!-- Active badge: success-green pill instead of
                                 accent-blue (less visually aggressive compared
                                 to the active selection highlight). -->
                            <DataGridTemplateColumn x:Name="ColVersionActive" Width="90" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SavedSuccessBrush}"
                                                CornerRadius="3" Padding="8,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{loc:Loc FM_ActiveBadge}"
                                                       Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="0"
                               Text="{Binding VersionsStatusMessage}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="{loc:Loc FM_MakeActive}"
                                Command="{Binding MakeActiveCommand}"
                                Style="{DynamicResource PrimaryButton}"
                                Width="160" Height="28"
                                Margin="0,0,8,0"
                                ToolTip="{loc:Loc FM_MakeActive_Tooltip}"/>
                        <Button Content="{loc:Loc FM_DeleteVersion}"
                                Command="{Binding DeleteVersionCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                Width="100" Height="28"
                                ToolTip="{loc:Loc FM_DeleteVersion_Tooltip}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="{loc:Loc Btn_OK}"
                    Command="{Binding OkCommand}"
                    Width="80" Height="28"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Grid.Column="2"
                    Content="{loc:Loc Btn_Cancel}"
                    Command="{Binding CancelAsyncCommand}"
                    Width="80" Height="28"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButton}"/>
        </Grid>
    </Grid>
</controls:DialogWindowBase>
