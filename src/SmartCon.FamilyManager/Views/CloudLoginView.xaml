<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.CloudLoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:behaviors="clr-namespace:SmartCon.UI.Behaviors;assembly=SmartCon.UI"
        xmlns:converters="clr-namespace:SmartCon.UI.Converters;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        Title="{loc:Loc FM_Cloud_LoginTitle}"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SingletonResources/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc FM_Cloud_LoginEndpoint}"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBox Grid.Row="1"
                 Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6,4"
                 Margin="0,0,0,10"
                 Style="{DynamicResource CompactTextBox}"
                 Background="Transparent"
                 behaviors:FocusBehavior.FocusOnLoad="True"/>

        <TextBlock Grid.Row="2"
                   Text="{loc:Loc FM_Cloud_LoginEmail}"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBox Grid.Row="3"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6,4"
                 Margin="0,0,0,10"
                 Style="{DynamicResource CompactTextBox}"
                 Background="Transparent"/>

        <TextBlock Grid.Row="4"
                   Text="{loc:Loc FM_Cloud_LoginPassword}"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <PasswordBox Grid.Row="5"
                     behaviors:PasswordBoxBehaviors.BindPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Margin="0,0,0,10"
                    Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc FM_Cloud_LoginDisplayName}"
                       Margin="0,0,0,2"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Style="{DynamicResource CompactTextBox}"
                     Background="Transparent"/>
        </StackPanel>

        <TextBlock Grid.Row="7"
                   Text="{Binding ErrorText}"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <ToggleButton Content="{loc:Loc FM_Cloud_LoginModeToggle_Register}"
                          IsChecked="{Binding IsRegisterMode}"
                          Style="{DynamicResource SecondaryToggleButton}"
                          Padding="8,4"
                          Cursor="Hand"/>
        </StackPanel>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding ActionButtonText}"
                    Command="{Binding SubmitCommand}"
                    MinWidth="110" Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="{loc:Loc Btn_Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="80" Height="28"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</controls:DialogWindowBase>
