<controls:DialogWindowBase x:Class="SmartCon.FamilyManager.Views.ProjectBaseRulesEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SmartCon.UI;assembly=SmartCon.UI"
        xmlns:controls="clr-namespace:SmartCon.UI.Controls;assembly=SmartCon.UI"
        xmlns:loc="clr-namespace:SmartCon.UI.Localization;assembly=SmartCon.UI"
        xmlns:vm="clr-namespace:SmartCon.FamilyManager.ViewModels.ProjectBase"
        Title="{loc:Loc FM_PBase_Title}"
        Width="750" Height="620" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ui:SingletonResources>
            <Style x:Key="CenterCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ui:SingletonResources>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc FM_PBase_Title}"
                   FontWeight="SemiBold" FontSize="15"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}">
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc FM_PBase_ProjectNameLabel}" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding CurrentProjectName}" VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{loc:Loc FM_PBase_FileNameBlocks}"
                       FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}">
            </TextBlock>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}" SelectedIndex="{Binding SelectedBlockIndex}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      Style="{DynamicResource CompactDataGrid}"
                      RowStyle="{DynamicResource CompactDataGridRow}"
                      CellStyle="{DynamicResource CompactDataGridCell}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColIndex" Header="{loc:Loc FM_PBase_ColIndex}" Binding="{Binding Index}" Width="40" IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterCell}">
                    </DataGridTextColumn>
                    <DataGridTemplateColumn x:Name="ColField" Header="{loc:Loc FM_PBase_ColField}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.FieldLibrary, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedValue="{Binding Field, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Name" DisplayMemberPath="Name"
                                          Style="{DynamicResource CompactComboBox}"
                                          HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ColParseRule" Header="{loc:Loc FM_PBase_ColParseRule}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ParseRuleDisplay}"
                                        Command="{Binding DataContext.OpenParseRuleEditorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{DynamicResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="6,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColValue" Header="{loc:Loc FM_PBase_ColValue}" Binding="{Binding CurrentFieldValue}" Width="*" IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterCell}">
                    </DataGridTextColumn>
                    <DataGridTemplateColumn x:Name="ColStatus" Header="{loc:Loc FM_PBase_ColStatus}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc FM_PBase_ValidField}"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Text" Value="{loc:Loc FM_PBase_InvalidField}"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{loc:Loc FM_PBase_AddBlock}" Command="{Binding AddBlockCommand}"
                    Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"/>
            <Button Content="{loc:Loc FM_PBase_RemoveBlock}" Command="{Binding RemoveBlockCommand}"
                    Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0"/>
            <Button Content="▲" Command="{Binding MoveBlockUpCommand}"
                    Style="{DynamicResource SecondaryButton}" Margin="0,0,2,0" MinWidth="28" Padding="4,2">
            </Button>
            <Button Content="▼" Command="{Binding MoveBlockDownCommand}"
                    Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" MinWidth="28" Padding="4,2">
            </Button>
            <Button Content="{loc:Loc FM_PBase_FieldLibrary}" Command="{Binding OpenFieldLibraryCommand}"
                    Style="{DynamicResource SecondaryButton}">
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Btn_OK}" IsDefault="True" Command="{Binding OkCommand}"
                    Style="{DynamicResource PrimaryButton}" Width="80" Height="28" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Btn_Cancel}" IsCancel="True" Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButton}" Width="80" Height="28"/>
        </StackPanel>
    </Grid>
</controls:DialogWindowBase>
