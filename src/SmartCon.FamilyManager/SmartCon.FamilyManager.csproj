<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartCon.FamilyManager</RootNamespace>
    <AssemblyName>SmartCon.FamilyManager</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CA1510: ArgumentNullException.ThrowIfNull unavailable on net48 (requires .NET 6+).
         Classic 'throw new ArgumentNullException(nameof(x))' is the multi-TFM compatible form. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>

  <!-- CommunityToolkit.Mvvm + M.D.Sqlite: на обеих TFM — внутри merged SmartCon.Dependencies (ADR-051) -->
  <ItemGroup>
    <ProjectReference Include="..\SmartCon.Dependencies\SmartCon.Dependencies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" />
  </ItemGroup>

  <!-- RevitAPI + RevitAPIUI: compile-time only (ExcludeAssets=runtime) -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- SQLitePCLRaw bundle: native e_sqlite3 + batteries Init — loose (managed-обёртка
       M.D.Sqlite merged в SmartCon.Dependencies, #177-аудит) -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- ADR-042 / Issue #129: 3D geometry preview — HelixToolkit.Wpf.SharpDX для ОБЕИХ TFM (net8 + net48).
       GLB writer теперь custom zero-dependency (manual JSON + binary GLB container), поэтому
       SharpGLTF.Core больше не используется. CS1739 workaround для format specifiers остаётся
       в силе для любых файлов, транзитивно ссылающихся на HelixToolkit/SharpDX. -->
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" />
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartCon.App" />
    <InternalsVisibleTo Include="SmartCon.Tests" />
    <InternalsVisibleTo Include="SmartCon.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartCon.Core\SmartCon.Core.csproj" />
    <ProjectReference Include="..\SmartCon.UI\SmartCon.UI.csproj" />
  </ItemGroup>

</Project>
