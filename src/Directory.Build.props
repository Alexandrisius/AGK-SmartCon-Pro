<Project>
  <!-- Per-configuration NuGet assets. Without this, all Debug.R* / Release.R* builds share
       obj/project.assets.json; every -c switch rewrites it with a different RevitAPI year
       (2025.* / 2026.* / 2027.* / 2024.* / 2021.*), which invalidates ResolvePackageAssets
       and forces a full rebuild of the entire project graph on every configuration step.
       Configuration is a global property (-c ...), available at this point in evaluation. -->
  <PropertyGroup Condition="'$(Configuration)' != ''">
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!-- Revit 2027 (net10) — ЕДИНСТВЕННЫЙ переключатель версии       -->
  <!-- ============================================================ -->
  <!-- Revit 2027 требует net10.0-windows, а значит SDK 10. На этой машине любая сборка
       SDK 10 идёт в 10-20 раз медленнее SDK 8 (dotnet/roslyn#81704: в компиляторе SDK 10
       выключен tiered compilation; фикс есть в 10.0.300+, но и на 10.0.404 холодная
       сборка графа = 98-115 с против 6-19 с у SDK 8). Поэтому R27 временно выключен,
       а global.json закреплён на SDK 8.0.4xx.
       ВЕРНУТЬ R27: true здесь + вернуть в global.json полосу 10.0.4xx. Больше ничего. -->
  <PropertyGroup>
    <SmartConEnableRevit2027 Condition="'$(SmartConEnableRevit2027)' == ''">false</SmartConEnableRevit2027>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!-- ШАГ 1: Парсим RevitVersion из имени конфигурации (.R21 → 2021) -->
  <!-- ДОЛЖНО идти ПЕРЕД TargetFrameworks, иначе $(RevitVersion) пуст -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="$(Configuration.EndsWith('.R19'))">
    <RevitVersion>2019</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R21'))">
    <RevitVersion>2021</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R22'))">
    <RevitVersion>2022</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R23'))">
    <RevitVersion>2023</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R24'))">
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R25'))">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R26'))">
    <RevitVersion>2026</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R27')) And '$(SmartConEnableRevit2027)' == 'true'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!-- ШАГ 2: Теперь RevitVersion задан — можно использовать в условии -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFrameworks>
    <!-- Revit 2027 перешёл на .NET 10 (Autodesk: "All add-ins must be built
         against the .NET 10 SDK") — собственная TFM, SDK 10 пинится global.json -->
    <TargetFrameworks Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(RevitVersion)' != '' And '$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">net48</TargetFrameworks>
    <TargetFrameworks Condition="'$(RevitVersion)' == ''">net48;net8.0-windows</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Временно подавить MSB3277 для первой net48-сборки, затем изучить и убрать -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);CA1001;CA1010;CA1305;CA1310;CA1707;CA1711;CA1716;CA1805;CA1822;CA1851;CA1852;CA1854;CA1859;CA1860;CA1861;CA1862;CA1866;CA1869</NoWarn>
    <!-- CA1510/CA1845/CA1846/CA1850/CA1865/CA2249 suggest .NET 8+ APIs
         (ArgumentNullException.ThrowIfNull, string.Contains(char/StringComparison),
         Concat(ReadOnlySpan...), SHA256.HashData, EndsWith(char)); the same sources
         must compile for net48 (Revit 2019-2024), where those APIs do not exist,
         so the analyzer suggestions cannot be applied project-wide. -->
    <NoWarn>$(NoWarn);CA1510;CA1845;CA1846;CA1850;CA1865;CA2249</NoWarn>

    <!-- Central Package Management: allow PackageVersion entries in Directory.Packages.props to
         override transitive dependencies declared in nested package metadata (e.g. Microsoft.Data.Sqlite
         8.0.27 declares SQLitePCLRaw.bundle_e_sqlite3 2.1.6 in its NuGet metadata, which otherwise
         surfaces as a duplicate e_sqlite3.dll during net48 publish → NETSDK1152). See
         https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management#transitive-pinning -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Именованные Build Configurations (паттерн Nice3point) -->
    <Configurations>Debug;Release</Configurations>
    <Configurations>$(Configurations);Debug.R19;Debug.R21;Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26</Configurations>
    <Configurations>$(Configurations);Release.R19;Release.R21;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26</Configurations>
    <Configurations Condition="'$(SmartConEnableRevit2027)' == 'true'">$(Configurations);Debug.R27;Release.R27</Configurations>

    <Company>AGK</Company>
    <Product>SmartCon</Product>
    <Copyright>Copyright © AGK 2026</Copyright>
    <Description>SmartCon — Intelligent MEP Connector for Autodesk Revit</Description>
    <PackageTags>revit;mep;pipe;connector;bim;autodesk</PackageTags>
    <RepositoryUrl>https://github.com/Alexandrisius/AGK-SmartCon-Pro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SmartConVersionFile>$(MSBuildThisFileDirectory)..\Version.txt</SmartConVersionFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Debug.*: skip IDE code-style + built-in CA analyzers to keep the build/deploy loop fast.
       Source generators (CommunityToolkit.Mvvm, PolySharp) and package analyzers stay enabled —
       they are required for compilation. Release.* (CI, release.ps1) keeps the full set.
       Produced IL is identical either way; analyzers do not affect codegen. -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- ============================================================
       DEBUG / TRACE symbols for custom Debug.* configurations
       ============================================================
       Microsoft.NET.Sdk auto-defines DEBUG + TRACE only for the base
       "Debug" Configuration. Custom names like "Debug.R21" / "Debug.R25"
       look like Debug builds by name, but unless we explicitly add the
       symbols here the compiler falls back to Release semantics:

         * DefineConstants has no DEBUG   ->   `#if DEBUG` branches go cold
         * Optimize defaults to true      ->   dead-code elim + no PDB
         * No `#if DEBUG` in SmartConLogger => _defaultMinLevel = Info
                                            => all Debug(...) calls dropped

       Symptom: log file is filled with [INF] but [DBG] lines are never
       written even though we deploy bin/Debug.R21/ output. The fix is
       to inject DEBUG/TRACE for every Configuration starting with "Debug".
       Release.* intentionally stays without DEBUG so the compiler still
       prunes the logger and other #[Conditional("DEBUG")] code. -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- C# polyfill: позволяет record, init, required на net48 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <NoWarn>$(NoWarn);CS0436;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Версия: ReadAllText + Trim надёжнее ReadLinesFromFile -->
  <PropertyGroup>
    <SmartConVersion>$([System.IO.File]::ReadAllText('$(SmartConVersionFile)').Trim())</SmartConVersion>
    <Version>$(SmartConVersion)</Version>
    <AssemblyVersion>$(SmartConVersion).0</AssemblyVersion>
    <FileVersion>$(SmartConVersion).0</FileVersion>
    <InformationalVersion>$(SmartConVersion)</InformationalVersion>
  </PropertyGroup>
  <Target Name="PrintSmartConVersion" BeforeTargets="PrepareForBuild">
    <Message Importance="High" Text="SmartCon version: $(SmartConVersion)" />
  </Target>
</Project>
