<Project>
  <!-- ============================================================ -->
  <!-- ШАГ 1: Парсим RevitVersion из имени конфигурации (.R21 → 2021) -->
  <!-- ДОЛЖНО идти ПЕРЕД TargetFrameworks, иначе $(RevitVersion) пуст -->
  <!-- ============================================================ -->
  <PropertyGroup Condition="$(Configuration.EndsWith('.R19'))">
    <RevitVersion>2019</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R21'))">
    <RevitVersion>2021</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R22'))">
    <RevitVersion>2022</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R23'))">
    <RevitVersion>2023</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R24'))">
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R25'))">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R26'))">
    <RevitVersion>2026</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.EndsWith('.R27'))">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!-- ШАГ 2: Теперь RevitVersion задан — можно использовать в условии -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFrameworks>
    <!-- Revit 2027 перешёл на .NET 10 (Autodesk: "All add-ins must be built
         against the .NET 10 SDK") — собственная TFM, SDK 10 пинится global.json -->
    <TargetFrameworks Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(RevitVersion)' != '' And '$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">net48</TargetFrameworks>
    <TargetFrameworks Condition="'$(RevitVersion)' == ''">net48;net8.0-windows</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Временно подавить MSB3277 для первой net48-сборки, затем изучить и убрать -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);CA1001;CA1010;CA1305;CA1310;CA1707;CA1711;CA1716;CA1805;CA1822;CA1851;CA1852;CA1854;CA1859;CA1860;CA1861;CA1862;CA1866;CA1869</NoWarn>

    <!-- Central Package Management: allow PackageVersion entries in Directory.Packages.props to
         override transitive dependencies declared in nested package metadata (e.g. Microsoft.Data.Sqlite
         8.0.27 declares SQLitePCLRaw.bundle_e_sqlite3 2.1.6 in its NuGet metadata, which otherwise
         surfaces as a duplicate e_sqlite3.dll during net48 publish → NETSDK1152). See
         https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management#transitive-pinning -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Именованные Build Configurations (паттерн Nice3point) -->
    <Configurations>Debug;Release</Configurations>
    <Configurations>$(Configurations);Debug.R19;Debug.R21;Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
    <Configurations>$(Configurations);Release.R19;Release.R21;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>

    <Company>AGK</Company>
    <Product>SmartCon</Product>
    <Copyright>Copyright © AGK 2026</Copyright>
    <Description>SmartCon — Intelligent MEP Connector for Autodesk Revit</Description>
    <PackageTags>revit;mep;pipe;connector;bim;autodesk</PackageTags>
    <RepositoryUrl>https://github.com/Alexandrisius/AGK-SmartCon-Pro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SmartConVersionFile>$(MSBuildThisFileDirectory)..\Version.txt</SmartConVersionFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- ============================================================
       DEBUG / TRACE symbols for custom Debug.* configurations
       ============================================================
       Microsoft.NET.Sdk auto-defines DEBUG + TRACE only for the base
       "Debug" Configuration. Custom names like "Debug.R21" / "Debug.R25"
       look like Debug builds by name, but unless we explicitly add the
       symbols here the compiler falls back to Release semantics:

         * DefineConstants has no DEBUG   ->   `#if DEBUG` branches go cold
         * Optimize defaults to true      ->   dead-code elim + no PDB
         * No `#if DEBUG` in SmartConLogger => _defaultMinLevel = Info
                                            => all Debug(...) calls dropped

       Symptom: log file is filled with [INF] but [DBG] lines are never
       written even though we deploy bin/Debug.R21/ output. The fix is
       to inject DEBUG/TRACE for every Configuration starting with "Debug".
       Release.* intentionally stays without DEBUG so the compiler still
       prunes the logger and other #[Conditional("DEBUG")] code. -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- C# polyfill: позволяет record, init, required на net48 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <NoWarn>$(NoWarn);CS0436;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Версия: ReadAllText + Trim надёжнее ReadLinesFromFile -->
  <PropertyGroup>
    <SmartConVersion>$([System.IO.File]::ReadAllText('$(SmartConVersionFile)').Trim())</SmartConVersion>
    <Version>$(SmartConVersion)</Version>
    <AssemblyVersion>$(SmartConVersion).0</AssemblyVersion>
    <FileVersion>$(SmartConVersion).0</FileVersion>
    <InformationalVersion>$(SmartConVersion)</InformationalVersion>
  </PropertyGroup>
  <Target Name="PrintSmartConVersion" BeforeTargets="PrepareForBuild">
    <Message Importance="High" Text="SmartCon version: $(SmartConVersion)" />
  </Target>
</Project>
